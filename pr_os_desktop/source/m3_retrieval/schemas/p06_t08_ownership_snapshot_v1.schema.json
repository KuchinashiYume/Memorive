{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pr-os.local/schemas/p06_t08_ownership_snapshot_v1.schema.json",
  "title": "PR-OS P06 T08 Ownership Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_ref",
    "effective_data_ownership",
    "ownership_mix_state",
    "ownership_contributors",
    "ownership_escalated_by",
    "ownership_digest",
    "ownership_resolution_status",
    "ownership_error_codes",
    "ownership_warnings",
    "ownership_contract_version",
    "ownership_aggregation_policy",
    "legacy_bucket"
  ],
  "properties": {
    "subject_ref": {"type": "string", "minLength": 1},
    "effective_data_ownership": {"enum": ["self", "entrusted", "unknown", null]},
    "ownership_mix_state": {"enum": ["uniform", "mixed", null]},
    "ownership_contributors": {
      "type": "array",
      "items": {"$ref": "#/$defs/contributor"},
      "uniqueItems": true
    },
    "ownership_escalated_by": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "ownership_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ownership_resolution_status": {"enum": ["resolved", "adapted", "blocked"]},
    "ownership_error_codes": {
      "type": "array",
      "items": {"$ref": "#/$defs/error_code"},
      "uniqueItems": true
    },
    "ownership_warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "ownership_contract_version": {"const": "P06_T08_OWNERSHIP_V1"},
    "ownership_aggregation_policy": {"const": "STRICTEST_V1"},
    "legacy_bucket": {
      "enum": [
        "L0_native_v1",
        "L1_traceable_card",
        "L2_conflicting_projection",
        "L3_insufficient_authority",
        "L4_malformed"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"ownership_resolution_status": {"const": "blocked"}}},
      "then": {
        "properties": {
          "effective_data_ownership": {"const": null},
          "ownership_mix_state": {"const": null},
          "ownership_error_codes": {"minItems": 1}
        }
      },
      "else": {
        "properties": {
          "effective_data_ownership": {"enum": ["self", "entrusted", "unknown"]},
          "ownership_mix_state": {"enum": ["uniform", "mixed"]},
          "ownership_error_codes": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_ref",
        "data_ownership",
        "assertion_ref",
        "revision",
        "basis_ref",
        "binding_digest"
      ],
      "properties": {
        "subject_ref": {"type": "string", "minLength": 1},
        "data_ownership": {"enum": ["self", "entrusted", "unknown", null]},
        "assertion_ref": {"type": ["string", "null"], "minLength": 1},
        "revision": {"type": ["integer", "null"], "minimum": 1},
        "basis_ref": {"type": ["string", "null"], "minLength": 1},
        "binding_digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "error_code": {
      "enum": [
        "OWNERSHIP_MISSING",
        "OWNERSHIP_INVALID",
        "OWNERSHIP_CONFLICT",
        "OWNERSHIP_DOWNGRADE_ATTEMPT",
        "OWNERSHIP_BINDING_MISMATCH",
        "OWNERSHIP_PROJECTION_STALE",
        "OWNERSHIP_AUTHORITY_INSUFFICIENT",
        "OWNERSHIP_LEGACY_ADAPTER_REQUIRED",
        "OWNERSHIP_LOCAL_ROUTE_UNAVAILABLE",
        "OWNERSHIP_VERSION_UNSUPPORTED",
        "EMPTY_CONTEXT_PACK"
      ]
    }
  }
}

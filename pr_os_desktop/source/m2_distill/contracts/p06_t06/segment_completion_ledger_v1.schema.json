{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pr-os.local/schemas/p06/t06/segment_completion_ledger_v1.schema.json",
  "title": "P06 T06 SegmentCompletionLedger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "paper_id", "source_manifest_hash", "topology_hash",
    "expected_segment_ids", "terminal_segment_ids", "missing_segment_ids",
    "terminal_shard_hashes", "attempts", "max_attempts_per_segment",
    "max_total_calls", "recovery_state", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "p06-t06-segment-completion-ledger-v1"},
    "paper_id": {"type": "string", "minLength": 1},
    "source_manifest_hash": {"$ref": "#/$defs/hash"},
    "topology_hash": {"$ref": "#/$defs/hash"},
    "expected_segment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/segmentId"}},
    "terminal_segment_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/segmentId"}},
    "missing_segment_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/segmentId"}},
    "terminal_shard_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}},
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "attempt_id", "state", "receipt_ref", "reason_code"],
        "properties": {
          "segment_id": {"$ref": "#/$defs/segmentId"},
          "attempt_id": {"type": "string", "minLength": 1},
          "state": {"enum": ["terminal", "invalid_for_merge", "retryable", "capacity_blocked", "foreign_input"]},
          "receipt_ref": {"type": "string", "minLength": 1},
          "reason_code": {"type": ["string", "null"]}
        }
      }
    },
    "max_attempts_per_segment": {"type": "integer", "minimum": 1},
    "max_total_calls": {"type": "integer", "minimum": 1},
    "recovery_state": {"enum": ["completed", "recoverable_pending", "capacity_blocked", "input_contract_blocked", "external_blocked", "failed_fidelity"]},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "segmentId": {"type": "string", "pattern": "^SEG-[A-F0-9]{24}$"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pr-os:p06:t11:local-execution-envelope:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "attempt", "logical_role", "profile_id", "ownership_identity", "input_locator", "input_sha256", "limits", "timeout_seconds", "max_attempts", "allowed_roots", "allowed_processes", "network_policy", "expected_output_schema", "expected_output_schema_sha256", "execution_mode", "payload_persisted"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "attempt": {"const": 1},
    "logical_role": {"enum": ["LOCAL_OCR", "LOCAL_DISTILL", "LOCAL_ANALYSIS", "LOCAL_VERIFY", "LOCAL_EMBED", "LOCAL_RETRIEVE"]},
    "profile_id": {"type": "string", "minLength": 1},
    "ownership_identity": {"type": "object", "minProperties": 1},
    "input_locator": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "limits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "max_attempts": {"const": 1},
    "allowed_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "allowed_processes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "network_policy": {"type": "string", "minLength": 1},
    "expected_output_schema": {"type": "string", "minLength": 1},
    "expected_output_schema_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "execution_mode": {"enum": ["OFFLINE_FAKE_A1", "LOCAL_QUALIFICATION_A", "LOCAL_ONLY_QUALIFICATION_B", "LOCAL_RUNTIME"]},
    "payload_persisted": {"const": false}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pr-os:p06:t11:combined-local-chain-verdict:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["chain_id", "verdict", "role_verdicts", "ownership_hard_gate", "zero_egress_hard_gate", "production_route", "activation_credit"],
  "properties": {
    "chain_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["FULL_LOCAL_CHAIN_QUALIFIED", "PARTIAL_LOCAL_CHAIN_KEEP_DISABLED", "LOCAL_CHAIN_BLOCKED_REQUIRED"]},
    "role_verdicts": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/roleVerdict"}},
    "ownership_hard_gate": {"enum": ["PASS", "FAIL", "NOT_ASSESSED"]},
    "zero_egress_hard_gate": {"enum": ["PASS", "FAIL", "NOT_ASSESSED"]},
    "production_route": {"const": "KEEP_DISABLED"},
    "activation_credit": {"const": false}
  },
  "$defs": {
    "roleVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_role", "profile_id", "verdict", "public_category", "limits", "route_eligibility", "activation_status", "evidence_refs", "reason_codes"],
      "properties": {
        "logical_role": {"enum": ["LOCAL_OCR", "LOCAL_DISTILL", "LOCAL_ANALYSIS", "LOCAL_VERIFY", "LOCAL_EMBED", "LOCAL_RETRIEVE"]},
        "profile_id": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["QUALIFIED_LOCAL_ONLY", "QUALIFIED_WITH_LIMITS", "KEEP_DISABLED_QUALITY", "KEEP_DISABLED_RESOURCE", "BLOCKED_IDENTITY", "BLOCKED_SECURITY", "NOT_ASSESSED_UPSTREAM"]},
        "public_category": {"enum": ["qualified", "keep-disabled", "blocked"]},
        "limits": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "route_eligibility": {"type": "integer", "enum": [0, 1]},
        "activation_status": {"enum": ["DISABLED", "ENABLED"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pr-os.local/schemas/p07/t08/connection_check_receipt_v1.schema.json",
  "title": "P07 T08 ConnectionCheckReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "check_id", "provider_id", "credential_ref", "requested_model_alias",
    "returned_model_alias", "key_state", "connection_state", "qualification_state",
    "enabled_state", "reason_code", "retryable", "checked_at", "network_requests",
    "external_model_requests"
  ],
  "properties": {
    "schema_version": {"const": "P07_T08_CONNECTION_CHECK_RECEIPT_V1"},
    "check_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "credential_ref": {"type": "string", "pattern": "^REF:FAKE:"},
    "requested_model_alias": {"type": "string", "minLength": 1},
    "returned_model_alias": {"type": ["string", "null"]},
    "key_state": {"enum": ["KEY_SAVED", "KEY_MISSING", "KEY_REVOKED"]},
    "connection_state": {"enum": ["CONNECTION_VERIFIED", "CONNECTION_FAILED", "VERIFICATION_NOT_RUN"]},
    "qualification_state": {"const": "NOT_ASSESSED"},
    "enabled_state": {"const": "DISABLED"},
    "reason_code": {"type": "string", "minLength": 1},
    "retryable": {"type": "boolean"},
    "checked_at": {"type": "string", "format": "date-time"},
    "network_requests": {"const": 0},
    "external_model_requests": {"const": 0}
  }
}

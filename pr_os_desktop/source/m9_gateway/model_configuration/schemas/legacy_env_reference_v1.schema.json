{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pr-os.local/schemas/p07/t08/legacy_env_reference_v1.schema.json",
  "title": "P07 T08 Legacy Environment Name Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "credential_ref", "env_name", "secret_value_read",
    "resolvable_in_t08", "migration_status", "projection_sha256"
  ],
  "properties": {
    "schema_version": {"const": "P07_T08_LEGACY_ENV_REFERENCE_V1"},
    "credential_ref": {"type": "string", "pattern": "^REF:LEGACY_ENV:[A-Z][A-Z0-9_]{2,127}$"},
    "env_name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
    "secret_value_read": {"const": false},
    "resolvable_in_t08": {"const": false},
    "migration_status": {"const": "REFERENCE_ONLY_REAL_BACKEND_NOT_ASSESSED"},
    "projection_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
  }
}

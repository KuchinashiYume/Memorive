{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pros:card-review:delta-review-atomic-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_reviews"],
  "properties": {
    "claim_reviews": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim_review"}
    }
  },
  "$defs": {
    "atom_status": {"type": "string", "enum": ["SUPPORTED", "PARTIAL", "UNSUPPORTED", "CONFLICT"]},
    "final_status": {"type": "string", "enum": ["RESOLVED", "STILL_FAIL", "NEW_CONFLICT", "NEED_EVIDENCE", "HUMAN_REQUIRED"]},
    "atom_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_id", "status", "evidence_chunk_ids", "reason"],
      "properties": {
        "atom_id": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/atom_status"},
        "evidence_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "evidence_chunk_ids", "reason"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "evidence_chunk_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "claim_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "atom_reviews", "cross_field_conflicts", "final_status"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "atom_reviews": {"type": "array", "items": {"$ref": "#/$defs/atom_review"}},
        "cross_field_conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}},
        "final_status": {"$ref": "#/$defs/final_status"}
      }
    }
  }
}

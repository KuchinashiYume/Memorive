{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pr-os.local/schemas/p06/t09/analysis-completed-event-v1",
  "title": "P06 T09 AnalysisCompletedEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_schema_version", "event_id", "analysis_artifact_ref", "analysis_artifact_sha256",
    "analysis_schema_ref", "analysis_revision", "context_pack_ref", "context_pack_sha256",
    "producer_binding_ref", "producer_behavior_hash", "ownership_snapshot_ref",
    "ownership_snapshot_sha256", "ownership_value", "completed_at", "source_commit",
    "source_tree", "completion_receipt_ref", "analysis_kind", "risk_tier", "stratum_id",
    "manual_review_required", "flagged_unsourced_count", "source_internal_inconsistency_count",
    "coverage_status", "answer_complete", "condition_codes", "safe_local_route_available",
    "producer_cohort", "content_hash"
  ],
  "properties": {
    "event_schema_version": {"const": "P06T09AnalysisCompletedEvent-v1"},
    "event_id": {"type": "string", "pattern": "^ACE-[0-9A-F]{32}$"},
    "analysis_artifact_ref": {"type": "string", "minLength": 1},
    "analysis_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "analysis_schema_ref": {"type": "string", "minLength": 1},
    "analysis_revision": {"type": "integer", "minimum": 1},
    "context_pack_ref": {"type": "string", "minLength": 1},
    "context_pack_sha256": {"$ref": "#/$defs/sha256"},
    "producer_binding_ref": {"type": "string", "minLength": 1},
    "producer_behavior_hash": {"$ref": "#/$defs/sha256"},
    "ownership_snapshot_ref": {"type": "string", "minLength": 1},
    "ownership_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "ownership_value": {"enum": ["self", "entrusted", "unknown", "mixed"]},
    "completed_at": {"type": "string", "format": "date-time"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "completion_receipt_ref": {"type": "string", "minLength": 1},
    "analysis_kind": {"type": "string", "minLength": 1},
    "risk_tier": {"type": "string", "minLength": 1},
    "stratum_id": {"type": "string", "minLength": 1},
    "manual_review_required": {"type": "boolean"},
    "flagged_unsourced_count": {"type": "integer", "minimum": 0},
    "source_internal_inconsistency_count": {"type": "integer", "minimum": 0},
    "coverage_status": {"type": "string", "minLength": 1},
    "answer_complete": {"type": "boolean"},
    "condition_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "safe_local_route_available": {"type": "boolean"},
    "producer_cohort": {"type": "string", "minLength": 1},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}}
}

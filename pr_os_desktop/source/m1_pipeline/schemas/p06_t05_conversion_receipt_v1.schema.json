{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pr-os.local/schemas/p06_t05_conversion_receipt_v1.schema.json",
  "title": "P06 T05 ConversionReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "created_at", "source_path_projection", "source_sha256",
    "source_size", "detected_format", "declared_extension", "signature_match", "data_ownership",
    "document_profile", "converter_profile_id", "engine", "engine_version", "runtime_version",
    "config_hash", "execution_status", "format_verdict", "selection_status", "recognition_status",
    "output_sha256", "rawmd_sha256", "cleanmd_sha256", "anchor_kind", "anchor_count", "anchor_map",
    "hard_failures", "degradation_signals", "warnings", "primary_receipt_id", "fallback_receipt_id",
    "selection_reason", "legacy_bridge_receipt", "image_frame_manifest", "nondeterminism_class", "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "P06T05ConversionReceipt-v1"},
    "receipt_id": {"type": "string", "pattern": "^T05R-[0-9a-f]{24}$"},
    "created_at": {"type": "string", "minLength": 1},
    "source_path_projection": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "source_size": {"type": "integer", "minimum": 0},
    "detected_format": {"enum": ["pdf", "md", "txt", "csv", "html", "docx", "pptx", "xlsx", "doc", "ppt", "xls", "jpeg", "png", "tiff"]},
    "declared_extension": {"type": "string", "pattern": "^\\."},
    "signature_match": {"type": "boolean"},
    "data_ownership": {"enum": ["self", "entrusted"]},
    "document_profile": {"type": "string", "minLength": 1},
    "converter_profile_id": {"type": "string", "minLength": 1},
    "engine": {"type": "string", "minLength": 1},
    "engine_version": {"type": "string", "minLength": 1},
    "runtime_version": {"type": "string", "minLength": 1},
    "config_hash": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "execution_status": {"enum": ["completed", "failed", "blocked"]},
    "format_verdict": {"enum": ["supported", "degraded", "unsupported"]},
    "selection_status": {"enum": ["primary_selected", "fallback_selected", "not_selected", "no_output"]},
    "recognition_status": {"enum": ["not_applicable", "not_run", "not_run_requires_t07"]},
    "output_sha256": {"type": ["string", "null"], "pattern": "^[0-9A-F]{64}$"},
    "rawmd_sha256": {"type": ["string", "null"], "pattern": "^[0-9A-F]{64}$"},
    "cleanmd_sha256": {"type": ["string", "null"], "pattern": "^[0-9A-F]{64}$"},
    "anchor_kind": {"enum": ["page", "slide", "sheet", "block", "line", "row", "frame"]},
    "anchor_count": {"type": "integer", "minimum": 0},
    "anchor_map": {"type": "array", "items": {"type": "object"}},
    "hard_failures": {"type": "array", "items": {"type": "string"}},
    "degradation_signals": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "primary_receipt_id": {"type": ["string", "null"]},
    "fallback_receipt_id": {"type": ["string", "null"]},
    "selection_reason": {"type": "string", "minLength": 1},
    "legacy_bridge_receipt": {"type": ["object", "null"]},
    "image_frame_manifest": {"type": ["object", "null"]},
    "nondeterminism_class": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "P05_T11_VECTOR_INDEX_GENERATION_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "generation_id",
    "parent_generation_id",
    "state",
    "compatibility_manifest_ref",
    "vector_compatibility_key_sha256",
    "collection_name",
    "collection_path",
    "collection_path_sha256",
    "distance_metric",
    "dimension",
    "normalization",
    "output_dtype",
    "member_count",
    "member_set_sha256",
    "writer",
    "readers",
    "created_at",
    "closed_at",
    "write_verification",
    "rollback_policy",
    "contract_identity_sha256"
  ],
  "properties": {
    "schema_version": {"const": "P05_T11_VECTOR_INDEX_GENERATION_V1"},
    "contract_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "generation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "parent_generation_id": {"type": ["string", "null"]},
    "state": {"const": "CLOSED_VERIFIED"},
    "compatibility_manifest_ref": {"type": "string", "minLength": 1},
    "vector_compatibility_key_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "collection_name": {"type": "string", "minLength": 3, "maxLength": 63},
    "collection_path": {"type": "string", "minLength": 1},
    "collection_path_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "distance_metric": {"const": "L2"},
    "dimension": {"type": "integer", "minimum": 1},
    "normalization": {"const": "L2_UNIT"},
    "output_dtype": {"const": "JSON_NUMBER_FINITE"},
    "member_count": {"type": "integer", "minimum": 1},
    "member_set_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "writer": {"const": "P05_T11_VECTOR_GENERATION_MANAGER"},
    "readers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "minLength": 1},
    "closed_at": {"type": "string", "minLength": 1},
    "write_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_count", "observed_count", "member_mismatch_count", "collection_metadata_match"],
      "properties": {
        "expected_count": {"type": "integer", "minimum": 1},
        "observed_count": {"type": "integer", "minimum": 0},
        "member_mismatch_count": {"type": "integer", "minimum": 0},
        "collection_metadata_match": {"type": "boolean"}
      }
    },
    "rollback_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "delete_parent_generation", "delete_generation_directory", "receipt_required"],
      "properties": {
        "mode": {"const": "DELETE_CURRENT_COLLECTION_ONLY"},
        "delete_parent_generation": {"const": false},
        "delete_generation_directory": {"const": false},
        "receipt_required": {"const": true}
      }
    },
    "contract_identity_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
  }
}


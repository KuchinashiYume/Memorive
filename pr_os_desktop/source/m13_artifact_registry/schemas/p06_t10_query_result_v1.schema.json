{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pros://m13/p06-t10/query-result/v1",
  "title": "P06 T10 QueryResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_schema_version",
    "query_id",
    "query_kind",
    "filters",
    "source",
    "projection_version",
    "freshness",
    "limit",
    "offset",
    "returned_count",
    "has_more",
    "rows",
    "nodes",
    "edges",
    "generated_at",
    "warnings",
    "result_digest"
  ],
  "properties": {
    "query_schema_version": {"const": "p06-t10-query-result-v1"},
    "query_id": {"type": "string", "pattern": "^query-[0-9a-f]{24}$"},
    "query_kind": {"enum": ["find_artifacts", "list_unresolved", "trace_lineage"]},
    "filters": {"type": "object"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_snapshot_id", "last_record_id", "record_count", "registry_content_hash"],
      "properties": {
        "registry_snapshot_id": {"type": "string", "pattern": "^snapshot-[0-9a-f]{32}$"},
        "last_record_id": {"type": ["string", "null"]},
        "record_count": {"type": "integer", "minimum": 0},
        "registry_content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "projection_version": {"const": "p06-t10-query-projection-v1"},
    "freshness": {"const": "FRESH"},
    "limit": {"type": "integer", "minimum": 1, "maximum": 500},
    "offset": {"type": "integer", "minimum": 0},
    "returned_count": {"type": "integer", "minimum": 0},
    "has_more": {"type": "boolean"},
    "rows": {"type": "array", "items": {"type": "object"}},
    "nodes": {"type": "array", "items": {"type": "object"}},
    "edges": {"type": "array", "items": {"type": "object"}},
    "generated_at": {"type": "string", "format": "date-time"},
    "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "result_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"}
  }
}

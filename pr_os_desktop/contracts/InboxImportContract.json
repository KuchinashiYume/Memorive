{
  "schema_version": "InboxImportContract-v1",
  "contract_revision": "P08-T05-InboxImportContract-r1",
  "allowed_extensions": [
    ".docx",
    ".jpeg",
    ".jpg",
    ".json",
    ".md",
    ".pdf",
    ".png",
    ".pptx",
    ".txt",
    ".xlsx"
  ],
  "copy": {
    "binding": "FileImportBinder",
    "destination": "sandbox_content_addressed_custody",
    "move_source": false,
    "delete_source": false,
    "source_identity_must_remain_stable": true
  },
  "dedupe": {
    "identity": "SHA256_OF_BOUND_BYTES",
    "duplicate_click_creates_second_effect": false,
    "same_name_different_content": "ALLOW_WITH_EXPLICIT_CONFLICT_RECEIPT"
  },
  "dispatch": {
    "boundary": "DURABLE_INTENT_ONLY",
    "idempotency_required": true,
    "production_ingestion": false,
    "external_effect_in_t05": false
  },
  "path_security": {
    "source_allowlist_required": true,
    "reject_device_paths": true,
    "reject_outside_allowlist": true,
    "reject_reparse_and_symlink": true,
    "reject_traversal": true
  },
  "retention": {
    "soft_delete": "SESSION_TRASH",
    "undo_redo": "SESSION_ONLY",
    "close": "RECYCLE_HANDOFF_PLAN_ONLY",
    "permanent_delete": false
  },
  "state_model": {
    "display": {
      "ERROR": "异常",
      "PROCESSING": "处理中",
      "QUEUED": "已排队"
    },
    "internal": [
      "IMPORTING",
      "QUEUED",
      "PROCESSING",
      "ERROR",
      "HANDED_OFF",
      "TRASHED",
      "DEDUPLICATED"
    ]
  }
}

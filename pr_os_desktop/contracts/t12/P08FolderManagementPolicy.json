{
  "schema_version": "P08FolderManagementPolicy-v1",
  "policy_id": "PR-OS-P08-FOLDER-MANAGEMENT",
  "revision": "r1.0",
  "effective_from_build": 77,
  "authority_scope": {
    "decision_source": "user_build077_instruction",
    "project_rules": [

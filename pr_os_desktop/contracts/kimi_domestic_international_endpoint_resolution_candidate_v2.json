{
  "schema_version": "KimiDomesticInternationalEndpointResolutionCandidate-v2",
  "status": "SANDBOX_CANDIDATE_NOT_PRODUCTION_ENABLED",
  "supersedes": "KimiDomesticInternationalEndpointResolutionCandidate-v1",
  "provider_scope": [
    "KIMI_API_KEY",
    "MOONSHOT_API_KEY"
  ],
  "problem": "Moonshot domestic and international credentials are independent and key text is not a reliable platform discriminator",
  "settings_interaction": {
    "placement": "SETTINGS_NETWORK_AND_PROXY",
    "visible_control": "one compact Kimi API site selector, hidden when no Kimi service exists",
    "model_card_behavior": "connection status and the existing model validation action only; no duplicate site selector",
    "label": "Kimi API 站点",
    "options": [
      {
        "value": "AUTO",
        "label": "自动识别（推荐）",
        "description": "only after the user clicks model validation, probe the official model catalog without sending exam or user content"
      },
      {
        "value": "CN",
        "label": "国内站",
        "api_base_url": "https://api.moonshot.cn/v1"
      },
      {
        "value": "AI",
        "label": "国际站",
        "api_base_url": "https://api.moonshot.ai/v1"
      }
    ],
    "mixed_or_custom_legacy_state": "display a read-only sentinel until the user explicitly chooses one official site",
    "unrelated_save_behavior": "preserve the current Kimi route when the site selector was not changed",
    "generic_custom_endpoint_editor_preserved": true
  },
  "settings_contract": {
    "optional_service_field": "api_platform",
    "allowed_values": [
      "AUTO",
      "CN",
      "AI"
    ],
    "non_kimi_service_behavior": "reject api_platform",
    "auto_unresolved_connection": {
      "api_protocol": "AUTO",
      "api_base_url": ""
    },
    "auto_resolved_cache_connection": {
      "api_protocol": "OPENAI_COMPATIBLE",
      "api_base_url": "one of the two exact official endpoints"
    },
    "explicit_connection": "OPENAI_COMPATIBLE plus the exact endpoint for the selected platform"
  },
  "resolution_policy": {
    "explicit_platform_precedence": true,
    "auto_probe_order": [
      "CN",
      "AI"
    ],
    "auto_probe_trigger": "existing model validation button",
    "cross_platform_fallback_only_after": "API_AUTHENTICATION_REJECTED",
    "network_rate_limit_or_invalid_catalog_behavior": "FAIL_CLOSED_WITHOUT_CROSS_PLATFORM_PROBE",
    "validation_endpoint_kind": "MODEL_CATALOG",
    "external_model_calls": 0,
    "exam_payload_included": false,
    "answer_key_included": false,
    "prompt_send_requires_resolution_status": "RESOLVED"
  },
  "cache_policy": {
    "persist": [
      "credential_ref",
      "credential_revision",
      "api_platform",
      "resolved platform",
      "api_base_url",
      "requested_model",
      "catalog_receipt_sha256"
    ],
    "forbid": [
      "secret_value",
      "secret_prefix",
      "secret_hash"
    ],
    "invalidate_on": [
      "credential replacement",
      "credential revocation",
      "provider change",
      "model change",
      "platform selection change"
    ],
    "credential_replacement_behavior": "mark every referencing service UNVERIFIED and clear only AUTO route caches"
  },
  "failure_semantics": {
    "both_platforms_authentication_rejected": "NOT_ASSESSED_CREDENTIAL_OR_PLATFORM_MISMATCH",
    "network_or_rate_limit": "NOT_ASSESSED_CONNECTIVITY",
    "model_not_listed_after_authenticated_catalog": "NOT_ASSESSED_MODEL_UNAVAILABLE",
    "never_model_fail_from_endpoint_resolution": true
  },
  "implementation_assets": [
    "construction/attempt001/source/pr_os_settings/kimi_endpoint.py",
    "construction/attempt001/source/pr_os_settings/contracts.py",
    "construction/attempt001/source/pr_os_settings/controller.py",
    "construction/attempt001/product/web/part3.html",
    "construction/attempt001/product/web/part3.css",
    "construction/attempt001/product/web/settings_bridge.js"
  ],
  "compatibility_wrapper": "construction/attempt001/tools/kimi_endpoint_resolution.py",
  "test_assets": [
    "construction/attempt001/tests/test_kimi_endpoint_resolution.py",
    "construction/attempt001/tests/test_kimi_network_adapter_settings.py"
  ]
}

{
  "schema_version": "pr-os.p08.t06.current-task-route-contract.v1",
  "route": "current-task",
  "initial_state": {
    "active_task_id": null,
    "selected_node_id": null,
    "second_level_open": false,
    "third_level_open": false,
    "task_list_width": "100%"
  },
  "task_selection": {
    "keeps_task_list": true,
    "opens_flow": true,
    "selects_default_node": false,
    "opens_inspector": false
  },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memorive.discovery.analysis.second-promotion-approval-receipt.v1",
  "title": "SecondPromotionApprovalReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "fixture_authority",
    "candidate_id",
    "card_revision",
    "candidate_bundle_hash",
    "target_namespace",
    "promotion_id",
    "paper_id",
    "target_prestate_hash",
    "decision",
    "decided_by",
    "authority_class",
    "decided_at",
    "expires_at",
    "revoked_at",
    "revocation_ref",
    "evidence_refs",
    "synthetic_fixture",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "memorive.discovery.analysis.second-promotion-approval-receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_authority": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "card_revision": {
      "type": "string",
      "minLength": 1
    },
    "candidate_bundle_hash": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "target_namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "promotion_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "target_prestate_hash": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT",
        "REPAIR",
        "SNOOZE"
      ]
    },
    "decided_by": {
      "type": "string",
      "minLength": 1
    },
    "authority_class": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "revocation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^fixture://"
      }
    },
    "synthetic_fixture": {
      "type": "boolean"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    }
  }
}

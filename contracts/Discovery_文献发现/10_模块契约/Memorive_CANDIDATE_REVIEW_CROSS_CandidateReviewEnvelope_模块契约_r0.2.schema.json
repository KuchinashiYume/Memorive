{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:discovery:candidate-review:candidate-review-envelope:r0.2",
  "title": "CandidateReviewEnvelope r0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "work_cluster_id",
    "manifestation_id",
    "candidate_revision",
    "source_revision",
    "materialization_revision",
    "card_revision",
    "processing_status",
    "decision_status",
    "review_status",
    "completion_status",
    "promotion_status",
    "semantic_verification",
    "deterministic_checks",
    "repair_of_bundle_sha256",
    "upstream_facts",
    "receipt_bindings",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "work_cluster_id": {
      "type": "string",
      "minLength": 1
    },
    "manifestation_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_revision": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "materialization_revision": {
      "type": "string",
      "minLength": 1
    },
    "card_revision": {
      "type": "string",
      "minLength": 1
    },
    "processing_status": {
      "enum": [
        "REVIEW_READY",
        "NEEDS_REPAIR"
      ]
    },
    "decision_status": {
      "enum": [
        "APPROVED_FOR_CARD_STAGING",
        "SNOOZED",
        "REJECTED"
      ]
    },
    "review_status": {
      "const": "pending"
    },
    "completion_status": {
      "const": "pending_review"
    },
    "promotion_status": {
      "const": "NOT_ELIGIBLE"
    },
    "semantic_verification": {
      "const": "NOT_PERFORMED"
    },
    "deterministic_checks": {
      "type": "object"
    },
    "repair_of_bundle_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        }
      ]
    },
    "upstream_facts": {
      "$ref": "#/$defs/upstreamFacts"
    },
    "receipt_bindings": {
      "$ref": "#/$defs/receiptBindings"
    },
    "provenance": {
      "type": "object"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "upstreamFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_contracts_source",
        "service_contracts_identity",
        "configuration_relation_novelty",
        "intake_selection",
        "verification_exposure_feedback"
      ],
      "properties": {
        "data_contracts_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_observation_ids",
            "source_snapshot_hash",
            "external_request_receipt_ids"
          ],
          "properties": {
            "source_observation_ids": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "source_snapshot_hash": {
              "$ref": "#/$defs/hash"
            },
            "external_request_receipt_ids": {
              "$ref": "#/$defs/nonEmptyStrings"
            }
          }
        },
        "service_contracts_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "work_cluster_id",
            "manifestation_id",
            "primary_identifiers",
            "identity_evidence_hash"
          ],
          "properties": {
            "work_cluster_id": {
              "type": "string",
              "minLength": 1
            },
            "manifestation_id": {
              "type": "string",
              "minLength": 1
            },
            "primary_identifiers": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "identity_evidence_hash": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "configuration_relation_novelty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "local_snapshot_id",
            "compared_local_paper_ids",
            "relation_types",
            "novelty_axes",
            "evidence_hash"
          ],
          "properties": {
            "local_snapshot_id": {
              "type": "string",
              "minLength": 1
            },
            "compared_local_paper_ids": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "relation_types": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "novelty_axes": {
              "type": "object",
              "minProperties": 1
            },
            "evidence_hash": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "intake_selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slate_id",
            "position",
            "channel",
            "primary_direction_id",
            "reason_codes",
            "ranking_evidence_ref",
            "slate_hash"
          ],
          "properties": {
            "slate_id": {
              "type": "string",
              "minLength": 1
            },
            "position": {
              "type": "integer",
              "minimum": 1
            },
            "channel": {
              "type": "string",
              "minLength": 1
            },
            "primary_direction_id": {
              "type": "string",
              "pattern": "^DIRECTION:[A-Z0-9_-]+$"
            },
            "reason_codes": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "ranking_evidence_ref": {
              "type": "string",
              "minLength": 1
            },
            "slate_hash": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "verification_exposure_feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "suppression_disposition",
            "reason_code",
            "direction_id",
            "direction_revision",
            "exposure_or_decision_refs",
            "evidence_hash"
          ],
          "properties": {
            "suppression_disposition": {
              "type": "string",
              "minLength": 1
            },
            "reason_code": {
              "type": "string",
              "minLength": 1
            },
            "direction_id": {
              "type": "string",
              "pattern": "^DIRECTION:[A-Z0-9_-]+$"
            },
            "direction_revision": {
              "type": "string",
              "minLength": 1
            },
            "exposure_or_decision_refs": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "evidence_hash": {
              "$ref": "#/$defs/hash"
            }
          }
        }
      }
    },
    "receiptBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_approval_receipt_sha256",
        "rights_receipt_sha256",
        "paper_identity_reservation_receipt_sha256",
        "generation_receipt_sha256"
      ],
      "properties": {
        "first_approval_receipt_sha256": {
          "$ref": "#/$defs/hash"
        },
        "rights_receipt_sha256": {
          "$ref": "#/$defs/hash"
        },
        "paper_identity_reservation_receipt_sha256": {
          "$ref": "#/$defs/hash"
        },
        "generation_receipt_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}

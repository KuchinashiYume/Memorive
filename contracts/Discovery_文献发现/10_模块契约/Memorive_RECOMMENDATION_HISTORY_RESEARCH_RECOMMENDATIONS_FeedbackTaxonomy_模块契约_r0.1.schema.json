{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:discovery:recommendation-history:feedback-taxonomy:0.1",
  "title": "Discovery Verification FeedbackTaxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "taxonomy_revision",
    "reasons",
    "ignored_interactions",
    "fuzzy_direction_propagation",
    "field_id_direction_substitution",
    "no_click_negative_feedback",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "discovery.verification.feedback-taxonomy.0.1"
    },
    "object_type": {
      "const": "FeedbackTaxonomy"
    },
    "taxonomy_revision": {
      "const": "Verification_FEEDBACK_TAXONOMY:r0.1"
    },
    "reasons": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason_code",
          "route",
          "scope",
          "negative_interest_signal",
          "confirmation"
        ],
        "properties": {
          "reason_code": {
            "enum": [
              "NOT_FOR_THIS_DIRECTION",
              "GLOBALLY_USELESS",
              "ALREADY_READ",
              "IN_LIBRARY",
              "SNOOZE",
              "NO_LEGAL_FULLTEXT",
              "CARD_ERROR",
              "MANIFESTATION_NOT_USEFUL"
            ]
          },
          "route": {
            "enum": [
              "SCOPED_DIRECTION_SUPPRESSION",
              "GLOBAL_EXCLUSION",
              "GLOBAL_DEDUPE",
              "TIME_BOUND_SNOOZE",
              "ACCESS_CHANGE_WAIT",
              "CARD_REPAIR",
              "MANIFESTATION_SCOPE_SUPPRESSION"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "negative_interest_signal": {
            "const": false
          },
          "confirmation": {
            "enum": [
              "EXPLICIT_DECISION",
              "SECOND_EXPLICIT_CONFIRMATION_REQUIRED"
            ]
          }
        }
      }
    },
    "ignored_interactions": {
      "type": "array",
      "prefixItems": [
        {
          "const": "NO_CLICK"
        },
        {
          "const": "TIMEOUT"
        },
        {
          "const": "NO_DECISION"
        }
      ],
      "items": false
    },
    "fuzzy_direction_propagation": {
      "const": false
    },
    "field_id_direction_substitution": {
      "const": false
    },
    "no_click_negative_feedback": {
      "const": false
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    }
  }
}

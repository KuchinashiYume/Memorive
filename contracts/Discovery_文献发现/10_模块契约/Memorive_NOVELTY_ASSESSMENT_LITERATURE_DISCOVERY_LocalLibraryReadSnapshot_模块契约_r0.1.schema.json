{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:discovery:novelty-assessment:local-library-read-snapshot:0.1",
  "title": "LocalLibraryReadSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "snapshot_id",
    "cutoff",
    "allowed_paper_ids",
    "coverage",
    "seen_candidate_ids",
    "vector_profiles",
    "records",
    "citation_edges",
    "direction_snapshot",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "discovery.configuration.local-library-read-snapshot.0.1"
    },
    "object_type": {
      "const": "LocalLibraryReadSnapshot"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^local_library_snapshot_[a-f0-9]{24}$"
    },
    "cutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_date",
        "observed_at"
      ],
      "properties": {
        "publication_date": {
          "type": "string",
          "format": "date"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "allowed_paper_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PAPER:[A-Z0-9_-]+$"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "seen_candidate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CANDIDATE:[A-Z0-9_-]+$"
      }
    },
    "vector_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "method",
        "object"
      ],
      "properties": {
        "topic": {
          "$ref": "#/$defs/vector_profile"
        },
        "method": {
          "$ref": "#/$defs/vector_profile"
        },
        "object": {
          "$ref": "#/$defs/vector_profile"
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/local_record"
      }
    },
    "citation_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation_edge"
      }
    },
    "direction_snapshot": {
      "$ref": "#/$defs/direction_snapshot"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "vector": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library_identity_complete",
        "first_seen_complete",
        "citation_complete",
        "direction_complete",
        "vector_dimensions_complete"
      ],
      "properties": {
        "library_identity_complete": {
          "type": "boolean"
        },
        "first_seen_complete": {
          "type": "boolean"
        },
        "citation_complete": {
          "type": "boolean"
        },
        "direction_complete": {
          "type": "boolean"
        },
        "vector_dimensions_complete": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "topic",
              "method",
              "object"
            ]
          }
        }
      }
    },
    "vector_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "dimension_name",
        "metric",
        "dimension",
        "threshold",
        "match_rule",
        "profile_hash"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^VECTOR_PROFILE:[A-Z0-9_-]+$"
        },
        "dimension_name": {
          "enum": [
            "topic",
            "method",
            "object"
          ]
        },
        "metric": {
          "enum": [
            "COSINE_SIMILARITY",
            "EUCLIDEAN_DISTANCE"
          ]
        },
        "dimension": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "threshold": {
          "type": "number"
        },
        "match_rule": {
          "enum": [
            "GTE",
            "LTE"
          ]
        },
        "profile_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "local_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "title",
        "active",
        "identity_status",
        "work_cluster_id",
        "manifestation_ids",
        "identifiers",
        "publication_date",
        "directions",
        "fields",
        "vectors",
        "vector_profile_refs",
        "version_links",
        "content_hash"
      ],
      "properties": {
        "paper_id": {
          "type": "string",
          "pattern": "^PAPER:[A-Z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "active": {
          "const": true
        },
        "identity_status": {
          "enum": [
            "VERIFIED",
            "CONFLICT",
            "UNRESOLVED"
          ]
        },
        "work_cluster_id": {
          "type": "string",
          "minLength": 1
        },
        "manifestation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "identifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "publication_date": {
          "type": "string",
          "format": "date"
        },
        "directions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DIRECTION:[A-Z0-9_-]+$"
          }
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topic",
            "method",
            "object",
            "abstract"
          ],
          "properties": {
            "topic": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "object": {
              "type": "string"
            },
            "abstract": {
              "type": "string"
            }
          }
        },
        "vectors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topic",
            "method",
            "object"
          ],
          "properties": {
            "topic": {
              "$ref": "#/$defs/vector"
            },
            "method": {
              "$ref": "#/$defs/vector"
            },
            "object": {
              "$ref": "#/$defs/vector"
            }
          }
        },
        "vector_profile_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topic",
            "method",
            "object"
          ],
          "properties": {
            "topic": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "object": {
              "type": "string"
            }
          }
        },
        "version_links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_manifestation_id",
              "local_manifestation_id",
              "evidence_ref"
            ],
            "properties": {
              "candidate_manifestation_id": {
                "type": "string"
              },
              "local_manifestation_id": {
                "type": "string"
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "citation_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "source_ref",
        "target_ref",
        "source_identifier",
        "target_identifier",
        "provenance_ref",
        "content_hash"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "pattern": "^CITATION_EDGE:[A-Z0-9_-]+$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_identifier": {
          "type": "string",
          "minLength": 1
        },
        "target_identifier": {
          "type": "string",
          "minLength": 1
        },
        "provenance_ref": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "direction_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directions",
        "content_hash"
      ],
      "properties": {
        "directions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "direction_id",
              "label",
              "evidence_scope"
            ],
            "properties": {
              "direction_id": {
                "type": "string",
                "pattern": "^DIRECTION:[A-Z0-9_-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "evidence_scope": {
                "enum": [
                  "METADATA_ONLY",
                  "ABSTRACT_LEVEL"
                ]
              }
            }
          }
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}

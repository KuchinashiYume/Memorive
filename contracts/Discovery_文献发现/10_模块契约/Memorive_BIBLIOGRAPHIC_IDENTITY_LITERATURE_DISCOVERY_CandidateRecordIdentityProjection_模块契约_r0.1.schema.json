{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:discovery:bibliographic-identity:candidate-record-identity-projection:0.1",
  "title": "Discovery ServiceContracts CandidateRecord Identity Projection",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "initializationRef": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$"
    },
    "observationRef": {
      "type": "string",
      "pattern": "^source_observation_[a-f0-9]{24}$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "object_id",
    "revision",
    "content_hash",
    "producer",
    "consumers",
    "single_writer",
    "parents",
    "supersedes",
    "immutable_fields",
    "candidate_id",
    "source_observation_refs",
    "identity_evidence_refs",
    "bibliographic_identity_refs",
    "work_cluster_id",
    "manifestation_ids",
    "review_queue_ref",
    "discovery_origin",
    "identity_status",
    "access_status",
    "decision_status",
    "candidate_card_status",
    "promotion_status",
    "configuration_input_eligible",
    "candidate_card_eligible",
    "eligibility_reason_codes",
    "is_synthetic"
  ],
  "properties": {
    "schema_version": {
      "const": "discovery.service_contracts.candidate-record-identity-projection.0.1"
    },
    "object_type": {
      "const": "CandidateRecord"
    },
    "object_id": {
      "$ref": "#/$defs/initializationRef"
    },
    "revision": {
      "const": 1
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "producer": {
      "const": "LITERATURE_DISCOVERY.CANDIDATE_REGISTRY"
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "NOVELTY-ASSESSMENT/CROSS",
          "RESEARCH_RECOMMENDATIONS.SLATE_BUILDER"
        ]
      }
    },
    "single_writer": {
      "const": "LITERATURE_DISCOVERY.CANDIDATE_REGISTRY"
    },
    "parents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/initializationRef"
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$"
    },
    "immutable_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidate_id": {
      "$ref": "#/$defs/initializationRef"
    },
    "source_observation_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/initializationRef"
      }
    },
    "identity_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/observationRef"
      }
    },
    "bibliographic_identity_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^bibliographic_identity_[a-f0-9]{24}$"
      }
    },
    "work_cluster_id": {
      "type": "string",
      "pattern": "^work_cluster_[a-f0-9]{24}$"
    },
    "manifestation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^manifestation_(identity|claim)_[a-f0-9]{24}$"
      }
    },
    "review_queue_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^identity_review_[a-f0-9]{24}$"
    },
    "discovery_origin": {
      "enum": [
        "KEYWORD_SEARCH",
        "CITATION_CHAIN",
        "SYNTHETIC_FIXTURE",
        "SYNTHETIC_A0_REPLAY"
      ]
    },
    "identity_status": {
      "enum": [
        "VERIFIED",
        "CONFLICT",
        "UNRESOLVED"
      ]
    },
    "access_status": {
      "const": "METADATA_ONLY"
    },
    "decision_status": {
      "const": "PENDING"
    },
    "candidate_card_status": {
      "const": "NOT_REQUESTED"
    },
    "promotion_status": {
      "const": "NOT_ELIGIBLE"
    },
    "configuration_input_eligible": {
      "type": "boolean"
    },
    "candidate_card_eligible": {
      "const": false
    },
    "eligibility_reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "IDENTITY_VERIFIED_FOR_Configuration_ONLY",
          "IDENTITY_CONFLICT",
          "IDENTITY_UNRESOLVED",
          "ServiceContracts_NEVER_GRANTS_CANDIDATE_CARD"
        ]
      }
    },
    "is_synthetic": {
      "const": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:discovery:bibliographic-identity:bibliographic-identity:0.1",
  "title": "Discovery ServiceContracts BibliographicIdentity",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "observationRef": {
      "type": "string",
      "pattern": "^source_observation_[a-f0-9]{24}$"
    },
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "base_value",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "DOI",
            "ARXIV",
            "PMID"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "base_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "object_id",
    "revision",
    "content_hash",
    "producer",
    "single_writer",
    "consumers",
    "identity_status",
    "canonical_identifiers",
    "manifestation_id",
    "source_observation_refs",
    "evidence_refs",
    "existence_evidence_level",
    "auto_merge_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "discovery.service_contracts.bibliographic-identity.0.1"
    },
    "object_type": {
      "const": "BibliographicIdentity"
    },
    "object_id": {
      "type": "string",
      "pattern": "^bibliographic_identity_[a-f0-9]{24}$"
    },
    "revision": {
      "const": 1
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "producer": {
      "const": "BIBLIOGRAPHIC-IDENTITY/LITERATURE_DISCOVERY"
    },
    "single_writer": {
      "const": "LITERATURE_DISCOVERY.IDENTITY_RESOLVER"
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "LITERATURE_DISCOVERY.CANDIDATE_REGISTRY",
          "NOVELTY-ASSESSMENT/CROSS"
        ]
      }
    },
    "identity_status": {
      "enum": [
        "VERIFIED",
        "CONFLICT",
        "UNRESOLVED"
      ]
    },
    "canonical_identifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "manifestation_id": {
      "type": "string",
      "pattern": "^manifestation_(identity|claim)_[a-f0-9]{24}$"
    },
    "source_observation_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/observationRef"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "existence_evidence_level": {
      "enum": [
        "TRUSTED_FROZEN_SOURCE_OBSERVATION",
        "CONFLICTING_FROZEN_SOURCE_OBSERVATION"
      ]
    },
    "auto_merge_allowed": {
      "type": "boolean"
    }
  }
}

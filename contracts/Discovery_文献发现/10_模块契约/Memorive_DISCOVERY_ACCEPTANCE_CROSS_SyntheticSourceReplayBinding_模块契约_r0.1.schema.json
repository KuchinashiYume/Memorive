{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:discovery:discovery-acceptance:synthetic-source-replay-binding:0.1",
  "title": "Discovery Integration SyntheticSourceReplayBinding r0.1",
  "$comment": "A0-only fixture binding. It is never evidence of API connectivity or an external request attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "fixture_classification",
    "run_kind",
    "run_id",
    "binding_id",
    "slot",
    "provider",
    "operation",
    "endpoint_family",
    "source_schema_revision",
    "request_attempt_id",
    "response_path",
    "response_sha256",
    "response_bytes",
    "parser_status",
    "records_count",
    "parsed_output_hash",
    "physical_network_calls",
    "external_call_performed",
    "source_evidence_ref",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "discovery.integration.synthetic-source-replay-binding.0.1"
    },
    "record_type": {
      "const": "synthetic_source_replay_binding"
    },
    "fixture_classification": {
      "const": "SELF_OWNED_PUBLIC_SAFE_SYNTHETIC_NOT_EXTERNAL_EVIDENCE"
    },
    "run_kind": {
      "const": "A0_SYNTHETIC"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "binding_id": {
      "type": "string",
      "pattern": "^SYNTHETIC-REPLAY-[A-Z0-9-]+$"
    },
    "slot": {
      "enum": [
        "G1",
        "G2"
      ]
    },
    "provider": {
      "enum": [
        "ARXIV",
        "CROSSREF"
      ]
    },
    "operation": {
      "const": "OFFLINE_FIXTURE_REPLAY"
    },
    "endpoint_family": {
      "enum": [
        "ARXIV_QUERY",
        "CROSSREF_WORKS"
      ]
    },
    "source_schema_revision": {
      "enum": [
        "ARXIV_ATOM_API",
        "CROSSREF_REST_WORKS_JSON"
      ]
    },
    "request_attempt_id": {
      "type": "string",
      "pattern": "^syntheticreplay_[a-f0-9]{24}$"
    },
    "response_path": {
      "type": "string",
      "pattern": "^responses/[A-Za-z0-9_.-]+$"
    },
    "response_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "response_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "parser_status": {
      "const": "SUCCESS"
    },
    "records_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "parsed_output_hash": {
      "$ref": "#/$defs/sha256"
    },
    "physical_network_calls": {
      "const": 0
    },
    "external_call_performed": {
      "const": false
    },
    "source_evidence_ref": {
      "type": "string",
      "pattern": "^fixture://discovery_acceptance/"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:discovery:bibliographic-identity:identity-review-queue-item:0.1",
  "title": "Discovery ServiceContracts IdentityReviewQueueItem",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "observationRef": {
      "type": "string",
      "pattern": "^source_observation_[a-f0-9]{24}$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "object_id",
    "review_item_id",
    "revision",
    "content_hash",
    "producer",
    "single_writer",
    "consumers",
    "reason_code",
    "status",
    "conflict_ref",
    "source_observation_refs",
    "candidate_work_cluster_refs",
    "required_action",
    "prohibited_actions",
    "external_task_created",
    "formal_write_performed"
  ],
  "properties": {
    "schema_version": {
      "const": "discovery.service_contracts.identity-review-queue-item.0.1"
    },
    "object_type": {
      "const": "IdentityReviewQueueItem"
    },
    "object_id": {
      "type": "string",
      "pattern": "^identity_review_[a-f0-9]{24}$"
    },
    "review_item_id": {
      "type": "string",
      "pattern": "^identity_review_[a-f0-9]{24}$"
    },
    "revision": {
      "const": 1
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "producer": {
      "const": "BIBLIOGRAPHIC-IDENTITY/LITERATURE_DISCOVERY"
    },
    "single_writer": {
      "const": "LITERATURE_DISCOVERY.IDENTITY_RESOLVER"
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "HUMAN_IDENTITY_REVIEW"
      }
    },
    "reason_code": {
      "enum": [
        "EXACT_IDENTIFIER_METADATA_CONFLICT",
        "CROSS_IDENTIFIER_CONFLICT",
        "UPSTREAM_IDENTITY_CONFLICT",
        "INVALID_IDENTIFIER",
        "VERSION_EVIDENCE_CONFLICT",
        "POSSIBLE_DUPLICATE_TITLE_ONLY"
      ]
    },
    "status": {
      "const": "OPEN"
    },
    "conflict_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^identity_conflict_[a-f0-9]{24}$"
    },
    "source_observation_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/observationRef"
      }
    },
    "candidate_work_cluster_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^work_cluster_[a-f0-9]{24}$"
      }
    },
    "required_action": {
      "const": "HUMAN_IDENTITY_REVIEW"
    },
    "prohibited_actions": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "AUTO_MERGE",
          "AUTO_SELECT",
          "CANDIDATE_CARD_ELIGIBILITY"
        ]
      }
    },
    "external_task_created": {
      "const": false
    },
    "formal_write_performed": {
      "const": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:discovery:discovery-channels:discovery-candidate-fact:0.1",
  "title": "Discovery Intake DiscoveryCandidateFact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "candidate_id",
    "work_cluster_id",
    "manifestation_ids",
    "canonical_identity",
    "title",
    "publication_date",
    "state_axes",
    "state_axes_unchanged",
    "relation_types",
    "relation_refs",
    "novelty_axes",
    "upstream_refs",
    "ranking_metadata",
    "side_effects",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "discovery.intake.discovery-candidate-fact.0.1"
    },
    "object_type": {
      "const": "DiscoveryCandidateFact"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^CANDIDATE:[A-Z0-9_-]+$"
    },
    "work_cluster_id": {
      "type": "string",
      "minLength": 1
    },
    "manifestation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "canonical_identity": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publication_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "state_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_status",
        "access_status",
        "decision_status",
        "candidate_card_status",
        "promotion_status"
      ],
      "properties": {
        "identity_status": {
          "enum": [
            "VERIFIED",
            "CONFLICT",
            "UNRESOLVED"
          ]
        },
        "access_status": {
          "type": "string"
        },
        "decision_status": {
          "type": "string"
        },
        "candidate_card_status": {
          "type": "string"
        },
        "promotion_status": {
          "type": "string"
        }
      }
    },
    "state_axes_unchanged": {
      "const": true
    },
    "relation_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "relation_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "novelty_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_new",
        "first_seen_new",
        "library_new",
        "direction_new"
      ],
      "properties": {
        "publication_new": {
          "enum": [
            "TRUE",
            "FALSE",
            "UNKNOWN"
          ]
        },
        "first_seen_new": {
          "enum": [
            "TRUE",
            "FALSE",
            "UNKNOWN"
          ]
        },
        "library_new": {
          "enum": [
            "TRUE",
            "FALSE",
            "UNKNOWN"
          ]
        },
        "direction_new": {
          "enum": [
            "TRUE",
            "FALSE",
            "UNKNOWN"
          ]
        }
      }
    },
    "upstream_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_hash",
        "comparison_hash"
      ],
      "properties": {
        "candidate_hash": {
          "$ref": "#/$defs/sha256"
        },
        "comparison_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "ranking_metadata": {
      "$ref": "#/$defs/rankingMetadata"
    },
    "side_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_mutations",
        "comparison_mutations",
        "production_writes"
      ],
      "properties": {
        "candidate_mutations": {
          "const": 0
        },
        "comparison_mutations": {
          "const": 0
        },
        "production_writes": {
          "const": 0
        }
      }
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "rankingMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_available",
        "authors",
        "institutions",
        "journal_id",
        "primary_direction_id",
        "direction_signals",
        "bridge_direction_refs",
        "horizon_anchor_refs",
        "coverage_gap_refs",
        "evidence_completeness",
        "manifestation_fitness",
        "timeliness",
        "access_posture",
        "evidence_refs"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_available": {
          "type": "boolean"
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "institutions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "journal_id": {
          "type": "string",
          "minLength": 1
        },
        "primary_direction_id": {
          "type": "string",
          "pattern": "^DIRECTION:[A-Z0-9_-]+$"
        },
        "direction_signals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "direction_id",
              "match",
              "evidence_ref"
            ],
            "properties": {
              "direction_id": {
                "type": "string",
                "pattern": "^DIRECTION:[A-Z0-9_-]+$"
              },
              "match": {
                "enum": [
                  "EXACT",
                  "RELATED",
                  "NONE"
                ]
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "bridge_direction_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DIRECTION:[A-Z0-9_-]+$"
          }
        },
        "horizon_anchor_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^HORIZON:[A-Z0-9_-]+$"
          }
        },
        "coverage_gap_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^GAP:[A-Z0-9_-]+$"
          }
        },
        "evidence_completeness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "manifestation_fitness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "timeliness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "access_posture": {
          "enum": [
            "OPEN",
            "METADATA_ONLY",
            "UNKNOWN"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

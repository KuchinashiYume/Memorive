{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:discovery:discovery-channels:research-context-detail:0.1",
  "title": "Discovery Intake ResearchContextDetail",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "context_id",
    "initialization_object_refs",
    "directions",
    "profile",
    "policy",
    "horizon_anchors",
    "coverage_gaps",
    "session",
    "is_synthetic",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "discovery.intake.research-context-detail.0.1"
    },
    "object_type": {
      "const": "ResearchContextDetail"
    },
    "context_id": {
      "type": "string",
      "pattern": "^Intake_CONTEXT:[A-Z0-9_-]+$"
    },
    "initialization_object_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "profile",
        "policy",
        "horizon",
        "session"
      ],
      "properties": {
        "direction": {
          "const": "DirectionDefinition"
        },
        "profile": {
          "const": "ResearchInterestProfile"
        },
        "policy": {
          "const": "ResearchExposurePolicy"
        },
        "horizon": {
          "const": "HorizonAnchor"
        },
        "session": {
          "const": "SessionResearchContext"
        }
      }
    },
    "directions": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "direction_id",
          "name",
          "scope",
          "revision",
          "human_confirmed"
        ],
        "properties": {
          "direction_id": {
            "type": "string",
            "pattern": "^DIRECTION:[A-Z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "human_confirmed": {
            "const": true
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "profile_id",
        "revision",
        "direction_refs",
        "explicit_user_source",
        "behavior_direct_write_forbidden"
      ],
      "properties": {
        "object_type": {
          "const": "ResearchInterestProfile"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^PROFILE:[A-Z0-9_-]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "direction_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^DIRECTION:[A-Z0-9_-]+$"
          }
        },
        "explicit_user_source": {
          "const": true
        },
        "behavior_direct_write_forbidden": {
          "const": true
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "policy_id",
        "revision",
        "batch_size",
        "channel_targets",
        "concentration_caps",
        "whitespace_slots",
        "no_backfill",
        "max_direction_share",
        "human_confirmed"
      ],
      "properties": {
        "object_type": {
          "const": "ResearchExposurePolicy"
        },
        "policy_id": {
          "type": "string",
          "pattern": "^POLICY:[A-Z0-9_-]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "channel_targets": {
          "$ref": "#/$defs/channelTargets"
        },
        "concentration_caps": {
          "$ref": "#/$defs/caps"
        },
        "whitespace_slots": {
          "type": "integer",
          "minimum": 0
        },
        "no_backfill": {
          "const": true
        },
        "max_direction_share": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "human_confirmed": {
          "const": true
        }
      }
    },
    "horizon_anchors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_type",
          "anchor_id",
          "direction_id",
          "description",
          "independent_of_local_similarity",
          "independent_of_behavior",
          "human_confirmed"
        ],
        "properties": {
          "object_type": {
            "const": "HorizonAnchor"
          },
          "anchor_id": {
            "type": "string",
            "pattern": "^HORIZON:[A-Z0-9_-]+$"
          },
          "direction_id": {
            "type": "string",
            "pattern": "^DIRECTION:[A-Z0-9_-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "independent_of_local_similarity": {
            "const": true
          },
          "independent_of_behavior": {
            "const": true
          },
          "human_confirmed": {
            "const": true
          }
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap_id",
          "direction_id",
          "reason",
          "frozen"
        ],
        "properties": {
          "gap_id": {
            "type": "string",
            "pattern": "^GAP:[A-Z0-9_-]+$"
          },
          "direction_id": {
            "type": "string",
            "pattern": "^DIRECTION:[A-Z0-9_-]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "frozen": {
            "const": true
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_type",
        "session_context_id",
        "intent",
        "source",
        "expires_at",
        "ttl_seconds",
        "long_term_profile_mutation",
        "long_term_policy_mutation"
      ],
      "properties": {
        "object_type": {
          "const": "SessionResearchContext"
        },
        "session_context_id": {
          "type": "string",
          "pattern": "^SESSION:[A-Z0-9_-]+$"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "const": "SYNTHETIC_TEST_LOCAL"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "long_term_profile_mutation": {
          "const": false
        },
        "long_term_policy_mutation": {
          "const": false
        }
      }
    },
    "is_synthetic": {
      "const": true
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "channelTargets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "CORE",
        "ADJACENT",
        "BRIDGE",
        "HORIZON",
        "COVERAGE_REPAIR"
      ],
      "properties": {
        "CORE": {
          "type": "integer",
          "minimum": 0
        },
        "ADJACENT": {
          "type": "integer",
          "minimum": 0
        },
        "BRIDGE": {
          "type": "integer",
          "minimum": 0
        },
        "HORIZON": {
          "type": "integer",
          "minimum": 0
        },
        "COVERAGE_REPAIR": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "institution",
        "journal",
        "source",
        "direction"
      ],
      "properties": {
        "author": {
          "type": "integer",
          "minimum": 1
        },
        "institution": {
          "type": "integer",
          "minimum": 1
        },
        "journal": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "integer",
          "minimum": 1
        },
        "direction": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:discovery:novelty-assessment:novelty-evidence:0.1",
  "title": "NoveltyEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "novelty_id",
    "candidate_id",
    "axes",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "discovery.configuration.novelty-evidence.0.1"
    },
    "object_type": {
      "const": "NoveltyEvidence"
    },
    "novelty_id": {
      "type": "string",
      "pattern": "^novelty_evidence_[a-f0-9]{24}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^CANDIDATE:[A-Z0-9_-]+$"
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_new",
        "first_seen_new",
        "library_new",
        "direction_new"
      ],
      "properties": {
        "publication_new": {
          "$ref": "#/$defs/axis"
        },
        "first_seen_new": {
          "$ref": "#/$defs/axis"
        },
        "library_new": {
          "$ref": "#/$defs/axis"
        },
        "direction_new": {
          "$ref": "#/$defs/axis"
        }
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "coverage_complete",
        "cutoff_or_reference",
        "reason_codes",
        "evidence_refs",
        "evidence_scope"
      ],
      "properties": {
        "status": {
          "enum": [
            "TRUE",
            "FALSE",
            "UNKNOWN"
          ]
        },
        "coverage_complete": {
          "type": "boolean"
        },
        "cutoff_or_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidence_scope": {
          "enum": [
            "METADATA_ONLY",
            "ABSTRACT_LEVEL_ESTIMATE",
            "COMPLETE_LIBRARY_SCOPE",
            "INCOMPLETE_SCOPE"
          ]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:discovery:source-connectors:source-observation:0.1",
  "title": "Discovery DataContracts SourceObservation",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identifierValue": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "given": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "locator",
        "materialized",
        "rights_status"
      ],
      "properties": {
        "kind": {
          "enum": [
            "LANDING_PAGE",
            "PDF_LOCATION_CLAIM",
            "METADATA_RECORD"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "materialized": {
          "const": false
        },
        "rights_status": {
          "enum": [
            "NOT_EVALUATED_SYNTHETIC",
            "LOCATION_CLAIM_ONLY"
          ]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "object_id",
    "revision",
    "content_hash",
    "producer",
    "single_writer",
    "consumers",
    "run_id",
    "source_connector",
    "source_snapshot_id",
    "discovery_origin",
    "observed_at",
    "identifiers",
    "bibliographic",
    "location_claims",
    "identity_status",
    "access_status",
    "decision_status",
    "candidate_card_status",
    "promotion_status",
    "source_evidence",
    "partial_fields",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "discovery.data_contracts.source-observation.0.1"
    },
    "object_type": {
      "const": "SourceObservation"
    },
    "object_id": {
      "type": "string",
      "pattern": "^source_observation_[a-f0-9]{24}$"
    },
    "revision": {
      "const": 1
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "producer": {
      "const": "SOURCE-CONNECTORS/LITERATURE_DISCOVERY"
    },
    "single_writer": {
      "const": "SOURCE-CONNECTORS/LITERATURE_DISCOVERY"
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "BIBLIOGRAPHIC-IDENTITY/LITERATURE_DISCOVERY",
          "NOVELTY-ASSESSMENT/CROSS",
          "DISCOVERY-CHANNELS/RESEARCH_RECOMMENDATIONS"
        ]
      }
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_connector": {
      "enum": [
        "ARXIV",
        "CROSSREF"
      ]
    },
    "source_snapshot_id": {
      "type": "string",
      "pattern": "^snapshot_[a-f0-9]{24}$"
    },
    "discovery_origin": {
      "enum": [
        "KEYWORD_SEARCH",
        "CITATION_CHAIN",
        "AUTHOR_WATCH",
        "SYNTHETIC_A0_REPLAY"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arxiv_id",
        "doi",
        "pmid",
        "source_record_id"
      ],
      "properties": {
        "arxiv_id": {
          "$ref": "#/$defs/identifierValue"
        },
        "doi": {
          "$ref": "#/$defs/identifierValue"
        },
        "pmid": {
          "$ref": "#/$defs/identifierValue"
        },
        "source_record_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "properties": {
            "arxiv_id": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "doi": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "pmid": {
              "type": "string"
            }
          }
        }
      ]
    },
    "bibliographic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "authors",
        "published_date",
        "updated_date",
        "abstract",
        "record_type"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/author"
          }
        },
        "published_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "updated_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "abstract": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "location_claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "identity_status": {
      "enum": [
        "VERIFIED",
        "CONFLICT",
        "UNRESOLVED"
      ]
    },
    "access_status": {
      "const": "METADATA_ONLY"
    },
    "decision_status": {
      "const": "PENDING"
    },
    "candidate_card_status": {
      "const": "NOT_REQUESTED"
    },
    "promotion_status": {
      "const": "NOT_ELIGIBLE"
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_sha256",
        "normalized_record_sha256",
        "fixture_classification",
        "network_used"
      ],
      "properties": {
        "snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalized_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fixture_classification": {
          "const": "SYNTHETIC_PUBLIC_SAFE_A0"
        },
        "network_used": {
          "const": false
        }
      }
    },
    "partial_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

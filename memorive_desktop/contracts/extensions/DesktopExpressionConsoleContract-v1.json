{
  "schema_version": "Memorive-ExpressionConsole-v1",
  "package_id": "v1.01",
  "stage": "CONSTRUCTION_A_NOT_ACCEPTED",
  "transport": "Existing authenticated ENV_V1 ephemeral loopback bridge",
  "base_path": "/memorive/test-bridge/v1",
  "permission": {
    "setting_label": "允许接入控制台",
    "default_enabled": false,
    "scope": "CURRENT_PROFILE",
    "remote_enable_supported": false,
    "shared_by": [
      "business_operations",
      "business_snapshot",
      "expression_trigger"
    ],
    "disabled_error": "CONSOLE_ACCESS_DISABLED",
    "disabled_allowed": [
      "session_start",
      "session_end",
      "metadata_diagnostics",
      "command_lifecycle_events",
      "expression_catalog",
      "expression_cached_state",
      "expression_cancel"
    ],
    "on_disable": "Cancel and restore visual preview; deny queued/new business commands; do not force-kill an already running business task"
  },
  "get_routes": [
    "/expressions/catalog",
    "/expressions/state"
  ],
  "command_operations": {
    "expression.trigger": {
      "params": {
        "event_id": "exact catalog ID",
        "duration_ms": "integer 500..5000"
      },
      "allow_model_calls": false
    },
    "expression.cancel": {
      "params": {},
      "allow_model_calls": false
    }
  },
  "event_count": 33,
  "groups": {
    "static_asset": 10,
    "native_pose": 11,
    "native_animation": 9,
    "web_animation": 3
  },
  "animation_ids": [
    "motion.blink",
    "motion.interaction",
    "motion.wake",
    "motion.message",
    "motion.working",
    "motion.attention",
    "motion.success",
    "motion.save-success",
    "motion.error",
    "animation.home-question",
    "animation.logo-compress",
    "animation.logo-shake"
  ],
  "duration_rule": "max(duration_ms, motion_ms + 250)",
  "one_probe_at_a_time": true,
  "states": [
    "ACCEPTED",
    "DISPLAYED",
    "RESTORING",
    "COMPLETED",
    "CANCELLED",
    "FAILED"
  ],
  "command_success_means": "Request accepted, NOT that the animation finished",
  "poll_interval_ms": 250,
  "sample_interval_ms": 100,
  "history_limit": 64,
  "events_limit": 128,
  "samples_per_probe_limit": 64,
  "monitor_reads": "Cached memory only; no UI/service/disk call and no heavy bridge snapshot lock",
  "native_transform_fields": [
    "frame",
    "offset_x",
    "offset_y",
    "rotation_degrees",
    "scale",
    "opacity"
  ],
  "native_transform_reference_px": 90,
  "native_frame_sha256_means": "Source frame identity, NOT transformed bitmap hash",
  "preview_asset_relative_path": "_internal/assets/illustrations",
  "native_frame_to_asset": {
    "idle": "one_eye",
    "blink-open": "neutral",
    "blink-closed": "sleepy",
    "interaction": "wink",
    "working": "shovel",
    "success": "writing",
    "save-success": "success",
    "error": "injury"
  },
  "no_business_events_injected": true,
  "no_model_calls": true,
  "no_preferences_changed_by_preview": true,
  "hide_expressions_respected": true,
  "explicit_animation_preview_uses_full_motion": true,
  "drag_preview_moves_window": false,
  "real_product_presentation_preempts_preview": true,
  "ui_thread_dispatch": "Bounded BeginInvoke; never hold product state or bridge lock during renderer work",
  "fixed_inputs_only": true,
  "arbitrary_script_path_url_model_parameters": false
}

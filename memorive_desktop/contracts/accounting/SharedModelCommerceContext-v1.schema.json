{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorive.local/schemas/SharedModelCommerceContext-v1.schema.json",
  "title": "SharedModelCommerceContext-v1",
  "description": "模型设置、计费面板与模型排行榜共同消费的只读模型身份和显示币种快照。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "revision",
    "settings_revision",
    "local_models_revision",
    "leaderboard_catalog_revision",
    "display_currency",
    "display_currency_label",
    "fx_snapshot",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": "SharedModelCommerceContext-v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "settings_revision": {
      "$ref": "#/$defs/revisionValue"
    },
    "local_models_revision": {
      "$ref": "#/$defs/nullableRevisionValue"
    },
    "leaderboard_catalog_revision": {
      "$ref": "#/$defs/nullableRevisionValue"
    },
    "display_currency": {
      "enum": [
        "USD",
        "CNY",
        "JPY"
      ]
    },
    "display_currency_label": {
      "enum": [
        "USD",
        "RMB",
        "JPY"
      ]
    },
    "fx_snapshot": {
      "$ref": "#/$defs/fxSnapshot"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modelProfile"
      }
    }
  },
  "$defs": {
    "revisionValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "nullableRevisionValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/revisionValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "fxSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "rate_date",
        "fetched_at",
        "status",
        "units_per_usd"
      ],
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "rate_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "fetched_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "CACHED",
            "EXPIRED",
            "MISSING",
            "INVALID"
          ]
        },
        "units_per_usd": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "USD",
            "CNY",
            "JPY"
          ],
          "properties": {
            "USD": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "CNY": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "JPY": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "sourceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settings_profile_key",
        "local_model_key"
      ],
      "properties": {
        "settings_profile_key": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 192
        },
        "local_model_key": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 192
        }
      }
    },
    "modelProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_ref",
        "profile_kind",
        "provider_label",
        "model_label",
        "model_id",
        "availability",
        "leaderboard_model_key",
        "source_bindings",
        "color"
      ],
      "properties": {
        "profile_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192
        },
        "profile_kind": {
          "enum": [
            "API",
            "CLI",
            "LOCAL"
          ]
        },
        "provider_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "model_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "availability": {
          "enum": [
            "AVAILABLE",
            "DISABLED",
            "UNAVAILABLE"
          ]
        },
        "leaderboard_model_key": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 192
        },
        "source_bindings": {
          "$ref": "#/$defs/sourceBindings"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    }
  }
}

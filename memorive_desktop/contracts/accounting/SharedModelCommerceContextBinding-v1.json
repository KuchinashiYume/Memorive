{
  "schema_version": "SharedModelCommerceContextBinding-v1",
  "target": "next build after public-interface; build number intentionally unallocated",
  "aggregator_method": "models.get_commerce_context_v1",
  "aggregator_status": "REFERENCE_IMPLEMENTATION_ONLY",
  "inputs": [
    {
      "method": "settings.get_state",
      "availability": "BASELINE",
      "paths": [
        "settings.model_services",
        "settings.cli_services",
        "revision"
      ],
      "purpose": "API and CLI profile identity, availability and provider labels"
    },
    {
      "method": "local_models.bootstrap",
      "availability": "BASELINE",
      "paths": [
        "recognized_models"
      ],
      "purpose": "local profile identity and availability"
    },
    {
      "method": "settings.leaderboard_get",
      "availability": "CONCURRENT_SANDBOX_INTEGRATION_PREP_NOT_PRODUCT",
      "paths": [
        "rows",
        "source_revision",
        "revision",
        "fx"
      ],
      "purpose": "exact leaderboard identity link and the single dated display FX snapshot"
    }
  ],
  "profile_mapping": {
    "API": {
      "profile_ref": "settings.model_services[].config_id",
      "model_id": "settings.model_services[].model_name",
      "provider": "settings.model_services[].provider"
    },
    "CLI": {
      "profile_ref": "settings.cli_services[].models[].profile_ref",
      "model_id": "settings.cli_services[].models[].model_name",
      "provider": "settings.cli_services[].display_name"
    },
    "LOCAL": {
      "profile_ref": "local_models.bootstrap.recognized_models[].profile_ref",
      "model_id": "local_models.bootstrap.recognized_models[].model_name",
      "provider": "local_models.bootstrap.recognized_models[].endpoint_name"
    }
  },
  "leaderboard_join": {
    "rule": "EXPLICIT_EXACT_ONLY",
    "accepted_key": "leaderboard_model_key",
    "on_missing": "null",
    "forbidden": [
      "display-name fuzzy match",
      "version collapse",
      "effort fallback",
      "provider guess"
    ]
  },
  "currency_mapping": {
    "source": "settings.leaderboard_get.fx.unitsPerUsd",
    "source_date": "settings.leaderboard_get.fx.rateDate",
    "source_snapshot_id": "settings.leaderboard_get.fx.id",
    "wire_cycle": [
      "USD",
      "CNY",
      "JPY"
    ],
    "display_cycle": [
      "USD",
      "RMB",
      "JPY"
    ],
    "display_only_alias": {
      "RMB": "CNY"
    },
    "failure": "keep native buckets and mark conversion unavailable"
  },
  "event_flow": {
    "settings_or_local_models_changed": "emit desktop:model-commerce-context-changed after a fresh normalized snapshot is available",
    "leaderboard_cache_or_fx_changed": "emit desktop:model-commerce-context-changed after settings.leaderboard_get observes the successor snapshot",
    "currency_changed_in_either_view": "emit desktop:display-currency-changed with USD CNY or JPY wire code",
    "loop_prevention": "event source identifier and context revision"
  },
  "refresh_boundary": {
    "accounting_refresh": "re-read local accounting and cached shared context only",
    "leaderboard_remote_refresh": "not triggered by the accounting refresh button",
    "external_network_calls": 0,
    "paid_model_calls": 0
  }
}

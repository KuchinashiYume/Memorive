{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:quality:run-ledger:runtime_log:terminal-ledger:1.0",
  "title": "Memorive RUNTIME_LOG Terminal Ledger Record v1",
  "description": "Human-readable mirror of the Python validator. Run lifecycle, acceptance, archive completeness and production status are deliberately outside the three ledger state enums.",
  "allOf": [
    {
      "$ref": "#/$defs/common"
    },
    {
      "oneOf": [
        {
          "$ref": "#/$defs/attempt"
        },
        {
          "$ref": "#/$defs/paperOutcome"
        },
        {
          "$ref": "#/$defs/publication"
        }
      ]
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "common": {
      "type": "object",
      "required": [
        "schema_version",
        "ledger_type",
        "record_id",
        "record_kind",
        "run_id",
        "created_at",
        "source_evidence_refs"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "ledger_type": {
          "enum": [
            "attempt",
            "paper_outcome",
            "publication"
          ]
        },
        "record_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "record_kind": {
          "enum": [
            "terminal",
            "amendment"
          ]
        },
        "run_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_evidence_refs": {
          "allOf": [
            {
              "$ref": "#/$defs/stringArray"
            },
            {
              "minItems": 1
            }
          ]
        }
      }
    },
    "attempt": {
      "type": "object",
      "required": [
        "attempt_id",
        "logical_operation_id",
        "attempt_no",
        "task_id",
        "stage",
        "paper_id",
        "retry_of_attempt_id",
        "business_repair_of",
        "route_snapshot_id",
        "execution_config_hash"
      ],
      "properties": {
        "ledger_type": {
          "const": "attempt"
        },
        "attempt_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "logical_operation_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "attempt_no": {
          "type": "integer",
          "minimum": 1
        },
        "retry_of_attempt_id": {
          "$ref": "#/$defs/nullableString"
        },
        "business_repair_of": {
          "$ref": "#/$defs/nullableString"
        },
        "task_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stage": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "paper_id": {
          "$ref": "#/$defs/nullableString"
        },
        "route_snapshot_id": {
          "$ref": "#/$defs/nullableString"
        },
        "execution_config_hash": {
          "$ref": "#/$defs/nullableString"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "result_category": {
          "enum": [
            "success",
            "failure",
            "incomplete",
            "error",
            "cancelled",
            "not_assessed"
          ]
        },
        "amends_attempt_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "amendment_fields": {
          "type": "object",
          "minProperties": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "record_kind": {
                "const": "terminal"
              }
            }
          },
          "then": {
            "required": [
              "started_at",
              "finished_at",
              "result_category"
            ]
          },
          "else": {
            "required": [
              "amends_attempt_id",
              "amendment_fields"
            ]
          }
        }
      ]
    },
    "paperOutcome": {
      "type": "object",
      "required": [
        "outcome_id",
        "paper_id",
        "outcome_category",
        "outcome_code",
        "reason_codes",
        "final_artifact_refs",
        "supersedes_record_id",
        "reprocesses_run_id"
      ],
      "properties": {
        "ledger_type": {
          "const": "paper_outcome"
        },
        "outcome_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "paper_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "outcome_category": {
          "enum": [
            "success",
            "failure",
            "partial",
            "not_run"
          ]
        },
        "outcome_code": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason_codes": {
          "allOf": [
            {
              "$ref": "#/$defs/stringArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "final_artifact_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "supersedes_record_id": {
          "$ref": "#/$defs/nullableString"
        },
        "reprocesses_run_id": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "publication": {
      "type": "object",
      "required": [
        "publication_event_id",
        "publication_status",
        "manifest_ref",
        "subject_artifact_refs",
        "receipt_ref",
        "supersedes_record_id"
      ],
      "properties": {
        "ledger_type": {
          "const": "publication"
        },
        "publication_event_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "publication_status": {
          "enum": [
            "not_requested",
            "not_published",
            "published",
            "publication_failed"
          ]
        },
        "manifest_ref": {
          "$ref": "#/$defs/nullableString"
        },
        "subject_artifact_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "receipt_ref": {
          "$ref": "#/$defs/nullableString"
        },
        "supersedes_record_id": {
          "$ref": "#/$defs/nullableString"
        }
      }
    }
  }
}

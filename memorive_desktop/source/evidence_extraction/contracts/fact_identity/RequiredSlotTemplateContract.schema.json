{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:quality:fact-identity:required-slot-template:r1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "template_id",
    "template_version",
    "literature_type",
    "literature_type_definition",
    "slot_contract_schema",
    "required_slots",
    "applicability_rules",
    "applicability_rule_definitions",
    "not_applicable_rule_definitions",
    "absence_check_policy",
    "authority",
    "approval_status",
    "approval_event_ref",
    "approved_by",
    "approved_at",
    "supersedes",
    "fixture_only",
    "simulation",
    "non_authoritative",
    "required_sections_or_roles",
    "promotion_rule",
    "approval_event_artifact",
    "derived_from_candidate"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "const": "required_slot_template_contract"
    },
    "template_id": {
      "const": "fact_identity-intervention-exposure-experimental-primary-study"
    },
    "template_version": {
      "const": "r1.0"
    },
    "literature_type": {
      "const": "intervention-or-prespecified-exposure-experimental-primary-study"
    },
    "literature_type_definition": {
      "type": "object"
    },
    "slot_contract_schema": {
      "type": "object"
    },
    "required_slots": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "slot_path",
          "slot_definition",
          "assessment_required",
          "cardinality",
          "card_field_candidates",
          "critical",
          "source_roles",
          "not_applicable_rule_ids"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "slot_path": {
            "type": "string",
            "pattern": "^/"
          },
          "slot_definition": {
            "type": "string",
            "minLength": 1
          },
          "assessment_required": {
            "const": true
          },
          "cardinality": {
            "enum": [
              "one",
              "many"
            ]
          },
          "card_field_candidates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "critical": {
            "type": "boolean"
          },
          "source_roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "not_applicable_rule_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "applicability_rules": {
      "type": "array"
    },
    "applicability_rule_definitions": {
      "type": "object"
    },
    "not_applicable_rule_definitions": {
      "type": "array"
    },
    "absence_check_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "artifact_path",
        "sha256",
        "authority",
        "approval_status"
      ],
      "properties": {
        "policy_id": {
          "const": "fact_identity-absence-policy-experimental-primary-study"
        },
        "policy_version": {
          "const": "r1.0"
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authority": {
          "const": "user-approved-contract"
        },
        "approval_status": {
          "const": "approved"
        }
      }
    },
    "authority": {
      "const": "user-approved-contract"
    },
    "approval_status": {
      "const": "approved"
    },
    "approval_event_ref": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {},
    "fixture_only": {
      "const": false
    },
    "simulation": {
      "const": false
    },
    "non_authoritative": {
      "const": false
    },
    "required_sections_or_roles": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "promotion_rule": {},
    "approval_event_artifact": {
      "type": "object"
    },
    "derived_from_candidate": {
      "type": "object"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:quality:fact-identity:fact-identity-sidecar:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "content_hash",
    "artifact_type",
    "schema_version",
    "sample_id",
    "paper_id",
    "card_artifact_ref",
    "source_artifact_ref",
    "fingerprint_policy_ref",
    "facts",
    "computed_at"
  ],
  "properties": {
    "artifact_id": {
      "$ref": "#/$defs/artifactId"
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    },
    "artifact_type": {
      "const": "fact_identity_sidecar"
    },
    "schema_version": {
      "const": "fact-identity-sidecar-v2"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "card_artifact_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "source_artifact_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "fingerprint_policy_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^art_[0-9a-f]{32}$"
    },
    "factId": {
      "type": "string",
      "pattern": "^fr_[0-9a-f]{32}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "content_hash"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "chunk_id",
        "quote",
        "source_content_hash",
        "policy_version"
      ],
      "properties": {
        "paper_id": {
          "type": "string",
          "minLength": 1
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "source_content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "policy_version": {
          "const": "fact_identity-anchor-normalization-r0.4"
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_id",
        "field_path",
        "source_anchor_refs"
      ],
      "properties": {
        "occurrence_id": {
          "type": "string",
          "minLength": 1
        },
        "field_path": {
          "type": "string",
          "pattern": "^/"
        },
        "source_anchor_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/anchor"
          }
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_claim_hash",
        "evidence_signature",
        "semantic_scope_key",
        "numeric_signature"
      ],
      "properties": {
        "normalized_claim_hash": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_signature": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_scope_key": {
          "$ref": "#/$defs/sha256"
        },
        "numeric_signature": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "identityProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "paper_id",
        "canonical_fingerprint_sha256",
        "occurrence_set_sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256-paper-scoped-fingerprint-v1"
        },
        "paper_id": {
          "type": "string",
          "minLength": 1
        },
        "canonical_fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "occurrence_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_record_id",
        "fact_fingerprint",
        "identity_proof",
        "occurrences",
        "merge_status"
      ],
      "properties": {
        "fact_record_id": {
          "$ref": "#/$defs/factId"
        },
        "fact_fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "identity_proof": {
          "$ref": "#/$defs/identityProof"
        },
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/occurrence"
          }
        },
        "merge_status": {
          "enum": [
            "distinct",
            "merged",
            "merge_ambiguous"
          ]
        }
      }
    }
  }
}

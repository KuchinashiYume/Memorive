{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorive.local/schemas/artifact_registry/artifact-envelope-v1.json",
  "title": "Memorive ARTIFACT_REGISTRY Artifact Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_type",
    "artifact_schema_ref",
    "content_hash",
    "locator",
    "run_ref",
    "route_snapshot_ref",
    "source_scope",
    "created_at",
    "registered_at",
    "parents",
    "lineage",
    "legacy_import",
    "evidence_refs",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "artifact-envelope-v1"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^art_[0-9a-f]{32}$"
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1
    },
    "artifact_schema_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "content_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "route_snapshot_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_ids",
        "source_artifact_ids"
      ],
      "properties": {
        "paper_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^art_[0-9a-f]{32}$"
          }
        }
      }
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "parents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parentLink"
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolved_parent_links",
        "unresolved_parent_requirements",
        "conflicting_candidates"
      ],
      "properties": {
        "resolved_parent_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parentLink"
          }
        },
        "unresolved_parent_requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unresolved"
          }
        },
        "conflicting_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conflict"
          }
        }
      }
    },
    "legacy_import": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "parentLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_artifact_id",
        "parent_content_hash",
        "relation",
        "evidence_basis"
      ],
      "properties": {
        "parent_artifact_id": {
          "type": "string",
          "pattern": "^art_[0-9a-f]{32}$"
        },
        "parent_content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "evidence_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "source_field",
            "evidence_ref",
            "details"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "source_field": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ref": {
              "type": "string",
              "minLength": 1
            },
            "details": {
              "type": "object"
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "reason_code",
        "evidence_refs",
        "candidate_artifact_ids",
        "search_hints"
      ],
      "properties": {
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidate_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^art_[0-9a-f]{32}$"
          }
        },
        "search_hints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "reason_code",
        "candidate_artifact_ids",
        "evidence_refs"
      ],
      "properties": {
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "candidate_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^art_[0-9a-f]{32}$"
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

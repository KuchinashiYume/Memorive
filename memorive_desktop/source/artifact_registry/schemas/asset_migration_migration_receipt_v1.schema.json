{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memorive://artifact_registry/asset_migration/migration-receipt/v1",
  "title": "Capabilities Logging MigrationItemReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_schema_version",
    "receipt_id",
    "batch_id",
    "item_id",
    "item_order",
    "phase",
    "recorded_at",
    "manifest_sha256",
    "item_sha256",
    "target_baseline_sha256",
    "outcome",
    "disposition",
    "event_id",
    "proof",
    "recovery_class",
    "error_code",
    "previous_receipt_sha256"
  ],
  "properties": {
    "receipt_schema_version": {
      "const": "asset_migration-migration-receipt-v1"
    },
    "receipt_id": {
      "$ref": "#/$defs/stableId"
    },
    "batch_id": {
      "$ref": "#/$defs/stableId"
    },
    "item_id": {
      "$ref": "#/$defs/stableId"
    },
    "item_order": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "ITEM_PREPARED",
        "REGISTRY_OUTCOME",
        "RECEIPT_COMMITTED",
        "RECEIPT_AMENDMENT"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "item_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_baseline_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "disposition": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "IMPORTED",
        "NOOP_EXACT",
        "UNRESOLVED_ACCEPTED",
        "REJECTED_BY_CONTRACT",
        "CONFLICT_BLOCKED",
        "ERROR_PARTIAL",
        "NOT_RUN"
      ]
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "proof": {
      "type": "object"
    },
    "recovery_class": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "previous_receipt_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "RECEIPT_COMMITTED"
          }
        },
        "required": [
          "phase"
        ]
      },
      "then": {
        "properties": {
          "disposition": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$"
    }
  }
}

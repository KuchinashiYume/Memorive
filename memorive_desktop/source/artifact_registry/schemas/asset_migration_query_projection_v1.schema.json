{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memorive://artifact_registry/asset_migration/query-projection/v1",
  "title": "Capabilities Logging QueryProjection build receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_schema_version",
    "build_status",
    "source_fingerprint",
    "built_at",
    "projection_path_class",
    "projection_sha256",
    "projection_bytes",
    "previous_projection",
    "data_digest",
    "row_counts",
    "atomic_replace",
    "authoritative",
    "reverse_write_api",
    "build_receipt_sha256"
  ],
  "properties": {
    "projection_schema_version": {
      "const": "asset_migration-query-projection-v1"
    },
    "build_status": {
      "const": "COMPLETED"
    },
    "source_fingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "built_at": {
      "type": "string",
      "format": "date-time"
    },
    "projection_path_class": {
      "const": "RUN_LOCAL_SQLITE"
    },
    "projection_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "projection_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "previous_projection": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bytes",
            "sha256"
          ],
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "data_digest": {
      "$ref": "#/$defs/sha256"
    },
    "row_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "artifacts",
        "parent_links",
        "unresolved_requirements",
        "conflicting_candidates",
        "artifact_papers",
        "artifact_sources"
      ],
      "properties": {
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "artifacts": {
          "type": "integer",
          "minimum": 0
        },
        "parent_links": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_requirements": {
          "type": "integer",
          "minimum": 0
        },
        "conflicting_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_papers": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_sources": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "atomic_replace": {
      "const": true
    },
    "authoritative": {
      "const": false
    },
    "reverse_write_api": {
      "const": false
    },
    "build_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_root_class",
        "registry_snapshot_id",
        "last_record_id",
        "record_count",
        "registry_content_hash",
        "annual_file_manifest",
        "envelope_schema_versions",
        "event_schema_versions",
        "current_envelope_schema_version",
        "current_event_schema_version",
        "projection_schema_version",
        "builder_code_sha256"
      ],
      "properties": {
        "registry_root_class": {
          "enum": [
            "ISOLATED_SANDBOX",
            "PRODUCTION_ARTIFACT_REGISTRY"
          ]
        },
        "registry_snapshot_id": {
          "type": "string",
          "pattern": "^snapshot-[0-9a-f]{32}$"
        },
        "last_record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "registry_content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "annual_file_manifest": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "bytes",
              "raw_sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[0-9]{4}\\.jsonl$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "raw_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "envelope_schema_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "event_schema_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current_envelope_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "current_event_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "projection_schema_version": {
          "const": "asset_migration-query-projection-v1"
        },
        "builder_code_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}

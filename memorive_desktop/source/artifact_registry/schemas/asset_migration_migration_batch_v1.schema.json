{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memorive://artifact_registry/asset_migration/migration-batch/v1",
  "title": "Capabilities Logging MigrationBatch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_schema_version",
    "batch_id",
    "mode",
    "authority_ref",
    "source_snapshot",
    "source_inventory_sha256",
    "target_registry_root_class",
    "target_registry_baseline",
    "items",
    "failure_policy",
    "external_side_effect_ceiling",
    "created_at"
  ],
  "properties": {
    "batch_schema_version": {
      "const": "asset_migration-migration-batch-v1"
    },
    "batch_id": {
      "$ref": "#/$defs/stableId"
    },
    "mode": {
      "enum": [
        "CAPABILITY_SANDBOX",
        "PRODUCTION_EXACT_BATCH"
      ]
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot": {
      "type": "object"
    },
    "source_inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_registry_root_class": {
      "enum": [
        "ISOLATED_SANDBOX",
        "PRODUCTION_ARTIFACT_REGISTRY"
      ]
    },
    "target_registry_baseline": {
      "$ref": "#/$defs/registryBaseline"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "failure_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight_failure",
        "unexpected_conflict",
        "runtime_error"
      ],
      "properties": {
        "preflight_failure": {
          "const": "STOP_BEFORE_FIRST_APPEND"
        },
        "unexpected_conflict": {
          "const": "STOP_AND_MARK_NOT_RUN"
        },
        "runtime_error": {
          "const": "STOP_AND_PRESERVE_PARTIAL"
        }
      }
    },
    "external_side_effect_ceiling": {
      "const": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "CAPABILITY_SANDBOX"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "target_registry_root_class": {
            "const": "ISOLATED_SANDBOX"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "PRODUCTION_EXACT_BATCH"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "target_registry_root_class": {
            "const": "PRODUCTION_ARTIFACT_REGISTRY"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]{0,127}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^art_[0-9a-f]{32}$"
    },
    "registryBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annual_file_manifest",
        "record_count",
        "last_record_id",
        "registry_content_hash"
      ],
      "properties": {
        "annual_file_manifest": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "bytes",
              "raw_sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[0-9]{4}\\.jsonl$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "raw_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "registry_content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "item_order",
        "source_locator_class",
        "source_locator",
        "expected_bytes",
        "expected_sha256",
        "rights",
        "classification",
        "artifact_type",
        "identity_basis",
        "expected_artifact_id",
        "run_ref",
        "schema_ref",
        "evidence_refs",
        "parent_artifacts",
        "unresolved_parent_requirements",
        "conflicting_candidates",
        "expected_disposition",
        "adapter_key",
        "adapter_version"
      ],
      "properties": {
        "item_id": {
          "$ref": "#/$defs/stableId"
        },
        "item_order": {
          "type": "integer",
          "minimum": 1
        },
        "source_locator_class": {
          "type": "string",
          "minLength": 1
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "expected_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rights": {
          "enum": [
            "self",
            "entrusted",
            "unknown",
            "blocked"
          ]
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "restricted",
            "private"
          ]
        },
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "identity_basis": {
          "type": "string",
          "minLength": 1
        },
        "expected_artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "run_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "schema_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parent_artifacts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "unresolved_parent_requirements": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "conflicting_candidates": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "expected_disposition": {
          "enum": [
            "IMPORTED",
            "NOOP_EXACT",
            "UNRESOLVED_ACCEPTED",
            "REJECTED_BY_CONTRACT",
            "CONFLICT_BLOCKED",
            "ERROR_PARTIAL",
            "NOT_RUN"
          ]
        },
        "adapter_key": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "paper_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "registered_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}

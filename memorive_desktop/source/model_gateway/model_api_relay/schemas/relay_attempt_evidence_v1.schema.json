{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:execution:model-api-relay:relay-attempt-evidence:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "retry_of",
    "fallback_of",
    "external_request_started",
    "lifecycle_result",
    "reason_code",
    "request_started_at",
    "request_finished_at",
    "request_id",
    "response_id",
    "profile_id",
    "profile_fingerprint",
    "qualification_key",
    "transport_kind",
    "protocol_family",
    "protocol_adapter_id",
    "protocol_revision",
    "endpoint_operator",
    "claimed_upstream_provider",
    "endpoint_origin_hash",
    "requested_model",
    "relay_reported_model",
    "returned_model",
    "independent_backend_identity",
    "identity_grade",
    "identity_reason_code",
    "response_body_models",
    "response_header_models",
    "response_event_models",
    "route",
    "region",
    "egress",
    "access_mode",
    "billing_mode",
    "behavior_hash",
    "input_hash",
    "output_hash",
    "latency_ms",
    "usage",
    "operator_billing",
    "upstream_billing",
    "source_evidence_refs",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "MODEL_API_RELAY_RELAY_ATTEMPT_EVIDENCE_V1"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "retry_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "fallback_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "external_request_started": {
      "type": "boolean"
    },
    "lifecycle_result": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "BLOCKED_PRE_SEND",
        "INVALIDATED"
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "response_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_fingerprint": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "qualification_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "transport_kind": {
      "type": "string",
      "minLength": 1
    },
    "protocol_family": {
      "type": "string",
      "minLength": 1
    },
    "protocol_adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_revision": {
      "type": "string",
      "minLength": 1
    },
    "endpoint_operator": {
      "type": "string",
      "minLength": 1
    },
    "claimed_upstream_provider": {
      "type": "string",
      "minLength": 1
    },
    "endpoint_origin_hash": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "requested_model": {
      "type": "string",
      "minLength": 1
    },
    "relay_reported_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "returned_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "independent_backend_identity": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_grade": {
      "enum": [
        "DIRECT_PROVIDER_VERIFIED",
        "RELAY_BACKEND_VERIFIED",
        "RELAY_REPORTED_UNVERIFIED",
        "RELAY_REPORTED_CONFLICT",
        "PROVIDER_NOT_EXPOSED"
      ]
    },
    "identity_reason_code": {
      "type": "string",
      "minLength": 1
    },
    "response_body_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "response_header_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "response_event_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "egress": {
      "type": "string",
      "minLength": 1
    },
    "access_mode": {
      "type": "string",
      "minLength": 1
    },
    "billing_mode": {
      "type": "string",
      "minLength": 1
    },
    "behavior_hash": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "output_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9A-F]{64}$"
    },
    "latency_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "total_tokens"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNKNOWN",
            "ACTUAL_REPORTED",
            "ACTUAL_VERIFIED"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "operator_billing": {
      "type": "object"
    },
    "upstream_billing": {
      "type": "object"
    },
    "source_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    }
  }
}

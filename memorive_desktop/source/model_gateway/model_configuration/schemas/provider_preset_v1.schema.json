{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorive.local/schemas/model_configuration/provider_preset_v1.schema.json",
  "title": "Integration Analysis ProviderPreset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "revision",
    "display_name",
    "protocol_family",
    "endpoint_policy",
    "preset_origin",
    "credential_backend_type",
    "model_discovery_policy",
    "thinking_mapping_revision",
    "price_metadata_source",
    "price_metadata_observed_at",
    "price_metadata_expires_at",
    "allowed_data_classes",
    "allowed_regions",
    "egress_class",
    "supported_roles",
    "supported_capabilities",
    "connection_check_method",
    "default_enabled",
    "known_limits"
  ],
  "properties": {
    "schema_version": {
      "const": "MODEL_CONFIGURATION_PROVIDER_PRESET_V1"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "protocol_family": {
      "enum": [
        "OPENAI_CHAT_COMPLETIONS",
        "OPENAI_RESPONSES",
        "ANTHROPIC_MESSAGES",
        "GEMINI_GENERATE_CONTENT",
        "LOCAL_IN_PROCESS_FAKE"
      ]
    },
    "endpoint_policy": {
      "enum": [
        "PRESET_ONLY",
        "CUSTOM_ADVANCED_ONLY"
      ]
    },
    "preset_origin": {
      "type": "string",
      "pattern": "^https://"
    },
    "credential_backend_type": {
      "const": "FAKE_IN_MEMORY"
    },
    "model_discovery_policy": {
      "const": "PINNED_PROFILE_ONLY"
    },
    "thinking_mapping_revision": {
      "type": "string",
      "minLength": 1
    },
    "price_metadata_source": {
      "type": "string",
      "minLength": 1
    },
    "price_metadata_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "price_metadata_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "allowed_data_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "egress_class": {
      "enum": [
        "external",
        "local"
      ]
    },
    "supported_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supported_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "connection_check_method": {
      "const": "IN_PROCESS_FAKE"
    },
    "default_enabled": {
      "const": false
    },
    "known_limits": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

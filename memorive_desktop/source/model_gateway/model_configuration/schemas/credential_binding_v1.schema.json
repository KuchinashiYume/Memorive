{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorive.local/schemas/model_configuration/credential_binding_v1.schema.json",
  "title": "Integration Analysis CredentialBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "revision",
    "provider_id",
    "credential_ref",
    "account_label",
    "state",
    "backend_type",
    "secret_present",
    "created_at",
    "rotated_at",
    "revoked_at",
    "previous_credential_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "MODEL_CONFIGURATION_CREDENTIAL_BINDING_V1"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "credential_ref": {
      "type": "string",
      "pattern": "^REF:FAKE:[A-Za-z0-9._-]+:v[1-9][0-9]*$"
    },
    "account_label": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "state": {
      "enum": [
        "STORED_UNVERIFIED",
        "CONNECTION_VERIFIED",
        "CONNECTION_FAILED",
        "VERIFICATION_NOT_RUN",
        "REPLACED",
        "REVOKED"
      ]
    },
    "backend_type": {
      "const": "FAKE_IN_MEMORY"
    },
    "secret_present": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "rotated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "previous_credential_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^REF:FAKE:[A-Za-z0-9._-]+:v[1-9][0-9]*$"
    }
  }
}

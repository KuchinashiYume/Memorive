{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorive.local/schemas/model_configuration/tier_resolution_v1.schema.json",
  "title": "Integration Analysis TierResolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resolver_revision",
    "policy_revision",
    "role",
    "requested_user_tier",
    "requested_thinking_enabled",
    "explicit_selection",
    "resolution_status",
    "profile_id",
    "provider_id",
    "model_alias",
    "credential_ref",
    "thinking_status",
    "native_effort",
    "native_projection",
    "data_classification",
    "egress_class",
    "region",
    "fallback_used",
    "fallback_requires_user_confirmation",
    "collapse_disclosure",
    "resolved_at",
    "resolution_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "MODEL_CONFIGURATION_TIER_RESOLUTION_V1"
    },
    "resolver_revision": {
      "type": "string",
      "minLength": 1
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "requested_user_tier": {
      "enum": [
        "economy",
        "standard",
        "high_quality",
        "maximum"
      ]
    },
    "requested_thinking_enabled": {
      "type": "boolean"
    },
    "explicit_selection": {
      "type": "boolean"
    },
    "resolution_status": {
      "enum": [
        "RESOLVED_UNIQUE",
        "COLLAPSED_DISCLOSED"
      ]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "model_alias": {
      "type": "string",
      "minLength": 1
    },
    "credential_ref": {
      "type": "string",
      "pattern": "^REF:FAKE:"
    },
    "thinking_status": {
      "enum": [
        "RESOLVED",
        "NOT_APPLICABLE"
      ]
    },
    "native_effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "native_projection": {
      "type": [
        "object",
        "null"
      ]
    },
    "data_classification": {
      "type": "string",
      "minLength": 1
    },
    "egress_class": {
      "enum": [
        "external",
        "local"
      ]
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "fallback_used": {
      "const": false
    },
    "fallback_requires_user_confirmation": {
      "type": "boolean"
    },
    "collapse_disclosure": {
      "type": [
        "object",
        "null"
      ]
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolution_sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    }
  }
}

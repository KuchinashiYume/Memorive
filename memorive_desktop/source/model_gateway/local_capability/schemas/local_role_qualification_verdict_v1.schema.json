{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:capabilities:local-inference:local-role-qualification-verdict:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "logical_role",
    "profile_id",
    "verdict",
    "public_category",
    "limits",
    "route_eligibility",
    "activation_status",
    "evidence_refs",
    "reason_codes"
  ],
  "properties": {
    "logical_role": {
      "enum": [
        "LOCAL_OCR",
        "LOCAL_DISTILL",
        "LOCAL_ANALYSIS",
        "LOCAL_VERIFY",
        "LOCAL_EMBED",
        "LOCAL_RETRIEVE"
      ]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "QUALIFIED_LOCAL_ONLY",
        "QUALIFIED_WITH_LIMITS",
        "KEEP_DISABLED_QUALITY",
        "KEEP_DISABLED_RESOURCE",
        "BLOCKED_IDENTITY",
        "BLOCKED_SECURITY",
        "NOT_ASSESSED_UPSTREAM"
      ]
    },
    "public_category": {
      "enum": [
        "qualified",
        "keep-disabled",
        "blocked"
      ]
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "route_eligibility": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "activation_status": {
      "enum": [
        "DISABLED",
        "ENABLED"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}

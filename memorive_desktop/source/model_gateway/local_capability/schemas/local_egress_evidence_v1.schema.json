{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:capabilities:local-inference:local-egress-evidence:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "execution_mode",
    "prevention_policy",
    "prevention_active",
    "observer_method",
    "observer_complete",
    "window_started_at",
    "window_ended_at",
    "process_tree_identity_match",
    "interface_set",
    "dns_events",
    "tcp_events",
    "udp_events",
    "http_events",
    "localhost_request_count",
    "forbidden_destination_count",
    "unattributed_event_count",
    "runtime_request_count",
    "final_zero_egress_verdict"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_mode": {
      "enum": [
        "OFFLINE_FAKE_A1",
        "LOCAL_QUALIFICATION_A",
        "LOCAL_ONLY_QUALIFICATION_B",
        "LOCAL_RUNTIME"
      ]
    },
    "prevention_policy": {
      "type": "string",
      "minLength": 1
    },
    "prevention_active": {
      "type": "boolean"
    },
    "observer_method": {
      "type": "string",
      "minLength": 1
    },
    "observer_complete": {
      "type": "boolean"
    },
    "window_started_at": {
      "type": "string",
      "minLength": 1
    },
    "window_ended_at": {
      "type": "string",
      "minLength": 1
    },
    "process_tree_identity_match": {
      "type": "boolean"
    },
    "interface_set": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dns_events": {
      "type": "integer",
      "minimum": 0
    },
    "tcp_events": {
      "type": "integer",
      "minimum": 0
    },
    "udp_events": {
      "type": "integer",
      "minimum": 0
    },
    "http_events": {
      "type": "integer",
      "minimum": 0
    },
    "localhost_request_count": {
      "type": "integer",
      "minimum": 0
    },
    "forbidden_destination_count": {
      "const": 0
    },
    "unattributed_event_count": {
      "const": 0
    },
    "runtime_request_count": {
      "type": "integer",
      "minimum": 0
    },
    "final_zero_egress_verdict": {
      "enum": [
        "PASS_OFFLINE_NO_RUNTIME",
        "PASS_ZERO_EGRESS",
        "FAIL"
      ]
    }
  }
}

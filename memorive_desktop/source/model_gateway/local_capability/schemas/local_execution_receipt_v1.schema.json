{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:capabilities:local-inference:local-execution-receipt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "request_id",
    "attempt",
    "logical_role",
    "profile_id",
    "requested_runtime",
    "actual_runtime",
    "requested_model",
    "actual_model",
    "manifest_id",
    "started_at",
    "ended_at",
    "latency_ms",
    "metrics",
    "resource_peaks",
    "schema_verdict",
    "quality_verdict",
    "zero_egress_verdict",
    "output_locator",
    "output_sha256",
    "error_class",
    "fallback_path",
    "final_status",
    "cloud_eligibility",
    "payload_persisted",
    "provider_cost_cny"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "const": 1
    },
    "logical_role": {
      "enum": [
        "LOCAL_OCR",
        "LOCAL_DISTILL",
        "LOCAL_ANALYSIS",
        "LOCAL_VERIFY",
        "LOCAL_EMBED",
        "LOCAL_RETRIEVE"
      ]
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_runtime": {
      "type": "string",
      "minLength": 1
    },
    "actual_runtime": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_model": {
      "type": "string",
      "minLength": 1
    },
    "actual_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "ended_at": {
      "type": "string",
      "minLength": 1
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "metrics": {
      "type": "object"
    },
    "resource_peaks": {
      "type": "object"
    },
    "schema_verdict": {
      "type": "string",
      "minLength": 1
    },
    "quality_verdict": {
      "type": "string",
      "minLength": 1
    },
    "zero_egress_verdict": {
      "type": "string",
      "minLength": 1
    },
    "output_locator": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        }
      ]
    },
    "error_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "fallback_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "final_status": {
      "enum": [
        "COMPLETED",
        "BLOCKED",
        "ERROR"
      ]
    },
    "cloud_eligibility": {
      "const": false
    },
    "payload_persisted": {
      "const": false
    },
    "provider_cost_cny": {
      "const": "0"
    }
  }
}

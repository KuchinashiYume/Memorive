{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:capabilities:local-inference:local-runtime-asset-manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "runtime_name",
    "runtime_version",
    "executable",
    "endpoint",
    "launch_mode",
    "allowed_parent_processes",
    "model_tag",
    "model_manifest",
    "model_blob",
    "projector",
    "source_locator",
    "acquired_date",
    "license_file",
    "license_verdict",
    "model_root",
    "acl_policy",
    "encryption_status",
    "backup_policy",
    "update_policy",
    "resource_baseline",
    "product_bundling_allowed"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_name": {
      "type": "string",
      "minLength": 1
    },
    "runtime_version": {
      "type": "string",
      "minLength": 1
    },
    "executable": {
      "$ref": "#/$defs/fileIdentity"
    },
    "endpoint": {
      "type": "string",
      "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]+)?/"
    },
    "launch_mode": {
      "type": "string",
      "minLength": 1
    },
    "allowed_parent_processes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "model_tag": {
      "type": "string",
      "minLength": 1
    },
    "model_manifest": {
      "$ref": "#/$defs/fileIdentity"
    },
    "model_blob": {
      "$ref": "#/$defs/fileIdentity"
    },
    "projector": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/fileIdentity"
        }
      ]
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "acquired_date": {
      "type": "string",
      "minLength": 1
    },
    "license_file": {
      "$ref": "#/$defs/fileIdentity"
    },
    "license_verdict": {
      "type": "string",
      "minLength": 1
    },
    "model_root": {
      "type": "string",
      "minLength": 1
    },
    "acl_policy": {
      "type": "string",
      "minLength": 1
    },
    "encryption_status": {
      "type": "string",
      "minLength": 1
    },
    "backup_policy": {
      "type": "string",
      "minLength": 1
    },
    "update_policy": {
      "type": "string",
      "minLength": 1
    },
    "resource_baseline": {
      "type": "object"
    },
    "product_bundling_allowed": {
      "const": false
    }
  },
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "sha256",
        "bytes"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

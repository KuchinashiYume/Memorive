{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:capabilities:local-inference:local-resource-envelope:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_id",
    "max_context_tokens",
    "max_pages",
    "max_image_pixels",
    "max_batch_size",
    "max_concurrency",
    "max_cpu_percent",
    "max_gpu_memory_mib",
    "max_ram_mib",
    "min_disk_free_mib",
    "timeout_seconds",
    "max_attempts",
    "reserved_headroom_percent",
    "oom_fallback_profile_id",
    "automatic_expansion_allowed",
    "implicit_truncation_allowed"
  ],
  "properties": {
    "envelope_id": {
      "type": "string",
      "minLength": 1
    },
    "max_context_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "max_pages": {
      "type": "integer",
      "minimum": 0
    },
    "max_image_pixels": {
      "type": "integer",
      "minimum": 0
    },
    "max_batch_size": {
      "type": "integer",
      "minimum": 1
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "max_cpu_percent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "max_gpu_memory_mib": {
      "type": "integer",
      "minimum": 0
    },
    "max_ram_mib": {
      "type": "integer",
      "minimum": 1
    },
    "min_disk_free_mib": {
      "type": "integer",
      "minimum": 0
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "max_attempts": {
      "const": 1
    },
    "reserved_headroom_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "oom_fallback_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "automatic_expansion_allowed": {
      "const": false
    },
    "implicit_truncation_allowed": {
      "const": false
    }
  }
}

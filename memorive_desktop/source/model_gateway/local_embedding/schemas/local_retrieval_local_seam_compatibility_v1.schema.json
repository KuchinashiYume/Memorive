{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "LOCAL_RETRIEVAL_LOCAL_SEAM_COMPATIBILITY_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "created_at",
    "source_evidence_refs",
    "runtime",
    "model",
    "limits",
    "physical_start_envelope",
    "chroma",
    "reranker",
    "accounting",
    "vector_compatibility_key_sha256",
    "manifest_identity_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "LOCAL_RETRIEVAL_LOCAL_SEAM_COMPATIBILITY_V1"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "source_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "version",
        "executable_sha256",
        "process_transport",
        "endpoint",
        "network_policy",
        "daemon_policy"
      ],
      "properties": {
        "provider": {
          "const": "ollama"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "process_transport": {
          "const": "local_process"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "network_policy": {
          "const": "LOOPBACK_ONLY"
        },
        "daemon_policy": {
          "const": "USE_EXISTING_ONLY_NO_START_STOP_RESTART"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_model",
        "canonical_model",
        "manifest_sha256",
        "model_layer_digest",
        "dimension",
        "normalization",
        "input_dtype",
        "output_dtype"
      ],
      "properties": {
        "requested_model": {
          "type": "string",
          "minLength": 1
        },
        "canonical_model": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "model_layer_digest": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "normalization": {
          "enum": [
            "L2_UNIT"
          ]
        },
        "input_dtype": {
          "const": "UTF8_TEXT"
        },
        "output_dtype": {
          "const": "JSON_NUMBER_FINITE"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_batch_size",
        "max_input_utf8_bytes",
        "timeout_seconds",
        "normalization_min",
        "normalization_max"
      ],
      "properties": {
        "max_batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "max_input_utf8_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "normalization_min": {
          "type": "number",
          "minimum": 0
        },
        "normalization_max": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "physical_start_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construction_a_embedding_requests_max",
        "shadow_b_embedding_requests_exact",
        "loopback_health_requests_max",
        "automatic_retry_per_request",
        "total_loopback_requests_max"
      ],
      "properties": {
        "construction_a_embedding_requests_max": {
          "const": 4
        },
        "shadow_b_embedding_requests_exact": {
          "const": 1
        },
        "loopback_health_requests_max": {
          "const": 2
        },
        "automatic_retry_per_request": {
          "const": 0
        },
        "total_loopback_requests_max": {
          "const": 7
        }
      }
    },
    "chroma": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_mode",
        "version",
        "distance_metric",
        "path_policy",
        "generation_root"
      ],
      "properties": {
        "client_mode": {
          "const": "PERSISTENT_CLIENT_LOCAL"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "distance_metric": {
          "const": "L2"
        },
        "path_policy": {
          "const": "ASCII_RUN_SUBTREE"
        },
        "generation_root": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reranker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "real_model_calls_max",
        "cloud_fallback"
      ],
      "properties": {
        "mode": {
          "enum": [
            "OFF",
            "DETERMINISTIC_INJECTED"
          ]
        },
        "real_model_calls_max": {
          "const": 0
        },
        "cloud_fallback": {
          "const": false
        }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inference_location",
        "access_mode",
        "billing_mode",
        "provider_tokens",
        "api_cost_cny",
        "external_request_limit"
      ],
      "properties": {
        "inference_location": {
          "const": "local_machine"
        },
        "access_mode": {
          "const": "local_runtime"
        },
        "billing_mode": {
          "const": "local_compute"
        },
        "provider_tokens": {
          "const": "N/A_LOCAL_COMPUTE"
        },
        "api_cost_cny": {
          "const": 0
        },
        "external_request_limit": {
          "const": 0
        }
      }
    },
    "vector_compatibility_key_sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "manifest_identity_sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    }
  }
}

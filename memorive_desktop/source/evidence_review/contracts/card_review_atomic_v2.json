{
  "review_contract_id": "card-review-atomic-v2",
  "input_schema_version": "atomic-review-view-v2",
  "atomic_claim_schema_version": "atomic-claim-v2",
  "full_review_schema_version": "full-review-atomic-v2",
  "delta_review_schema_version": "delta-review-atomic-v2",
  "evidence_policy_version": "evidence-direct-support-v2",
  "safety_policy_version": "review-safety-v2",
  "gold_suite_version": "card-review-gold-v2",
  "route_policy_version": "card-review-route-v2",
  "core_fields": [
    "research_question",
    "research_object",
    "method",
    "key_results",
    "author_conclusion",
    "boundary_conditions"
  ],
  "atom_types": [
    "research_object",
    "research_relation",
    "population_or_system",
    "sample_control",
    "intervention",
    "method_step",
    "instrument",
    "parameter",
    "value",
    "unit",
    "direction",
    "phase_time",
    "sample_size",
    "statistical_scope",
    "comparison",
    "claim_strength",
    "conclusion_scope",
    "limitation",
    "applicability",
    "uncertainty",
    "source_anchor"
  ],
  "atom_statuses": [
    "SUPPORTED",
    "PARTIAL",
    "UNSUPPORTED",
    "CONFLICT"
  ],
  "coverage_statuses": [
    "SUPPORTED",
    "PARTIAL",
    "MISSING",
    "CONFLICT"
  ],
  "delta_statuses": [
    "RESOLVED",
    "STILL_FAIL",
    "NEW_CONFLICT",
    "NEED_EVIDENCE",
    "HUMAN_REQUIRED"
  ],
  "evidence_policy": {
    "chunk_must_exist": true,
    "chunk_must_belong_to_paper": true,
    "evidence_must_directly_support_diagnosis": true,
    "quote_when_present_must_be_verbatim_substring": true,
    "unread_scope_cannot_be_reported_as_covered": true
  },
  "full_requirements": {
    "all_core_fields_have_receipts": true,
    "all_required_atoms_have_reviews": true,
    "missing_core_claims_are_reported": true,
    "method_omissions_are_reported": true,
    "cross_field_conflicts_are_reported": true,
    "model_output_cannot_finalize_card": true
  },
  "delta_requirements": {
    "all_current_required_atoms_are_rescanned": true,
    "all_required_atoms_supported_before_resolved": true,
    "no_cross_field_conflict_before_resolved": true,
    "delta_cannot_claim_whole_card_pass": true
  },
  "dangerous_errors": [
    "FALSE_RESOLVED",
    "UNSAFE_PASS",
    "UNSUPPORTED_ANCHOR_ACCEPTED",
    "CROSS_FIELD_CONFLICT_MISSED",
    "MISSING_EVIDENCE_ACCEPTED",
    "SILENT_TRUNCATION"
  ],
  "pass_semantics": {
    "model_pass_name": "MODEL_REVIEW_PASS",
    "card_pass_name": "CARD_REVIEW_PASS",
    "card_pass_requires_local_mechanical_pass": true
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:integration:application-facade:error-envelope:v1",
  "title": "Memorive Error Envelope v1",
  "type": "object",
  "required": [
    "schema_version",
    "contract_revision",
    "error_code",
    "category",
    "severity",
    "retryable",
    "user_action",
    "technical_summary",
    "correlation_id",
    "support_bundle_recommended"
  ],
  "properties": {
    "schema_version": {
      "const": "ErrorEnvelope-v1"
    },
    "contract_revision": {
      "const": "1.0"
    },
    "error_code": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "INFO",
        "WARN",
        "ERROR",
        "FATAL"
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "retry_after": {
      "type": [
        "string",
        "null"
      ]
    },
    "user_action": {
      "type": "string",
      "minLength": 1
    },
    "technical_summary": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "cause_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "support_bundle_recommended": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}

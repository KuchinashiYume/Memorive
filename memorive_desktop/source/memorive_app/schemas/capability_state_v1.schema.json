{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memorive:integration:application-facade:capability-state:v1",
  "title": "Memorive Capability State v1",
  "type": "object",
  "required": [
    "capability_id",
    "requirement",
    "availability",
    "qualification",
    "effective_enabled",
    "reason_code",
    "required_action"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "requirement": {
      "enum": [
        "required",
        "optional"
      ]
    },
    "availability": {
      "enum": [
        "ready",
        "disabled",
        "not_configured",
        "not_applicable",
        "blocked"
      ]
    },
    "qualification": {
      "enum": [
        "qualified",
        "not_qualified",
        "not_assessed"
      ]
    },
    "effective_enabled": {
      "type": "boolean"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "required_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}

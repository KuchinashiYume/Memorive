{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memorive.local/schemas/document_formats_conversion_amendment_v1.schema.json",
  "title": "Capabilities Intake ConversionAmendment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "amendment_id",
    "created_at",
    "supersedes_receipt_id",
    "old_output_sha256",
    "new_output_sha256",
    "decision",
    "reason",
    "evidence_refs",
    "decision_maker"
  ],
  "properties": {
    "schema_version": {
      "const": "DocumentFormatsConversionAmendment-v1"
    },
    "amendment_id": {
      "type": "string",
      "pattern": "^IntakeA-[0-9a-f]{24}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "supersedes_receipt_id": {
      "type": "string",
      "pattern": "^IntakeR-[0-9a-f]{24}$"
    },
    "old_output_sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "new_output_sha256": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{64}$"
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "decision_maker": {
      "type": "string",
      "minLength": 1
    }
  }
}

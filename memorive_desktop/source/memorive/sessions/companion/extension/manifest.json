{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "4.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://gemini.google.com/*",
    "https://kimi.com/*",
    "https://www.kimi.com/*",
    "https://kimi.moonshot.cn/*",
    "https://chat.qwen.ai/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://grok.com/*",
    "https://www.qianwen.com/*",
    "https://qianwen.com/*",
    "https://tongyi.aliyun.com/*",
    "https://www.doubao.com/*",
    "https://doubao.com/*",
    "https://yuanbao.tencent.com/*",
    "https://yiyan.baidu.com/*",
    "https://chatglm.cn/*",
    "https://copilot.microsoft.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://poe.com/*",
    "https://chat.mistral.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://chat.qwen.ai/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://grok.com/*",
        "https://www.qianwen.com/*",
        "https://qianwen.com/*",
        "https://tongyi.aliyun.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*",
        "https://yuanbao.tencent.com/*",
        "https://yiyan.baidu.com/*",
        "https://chatglm.cn/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://poe.com/*",
        "https://chat.mistral.ai/*"
      ],
      "js": [
        "site_profiles.js",
        "recording.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}

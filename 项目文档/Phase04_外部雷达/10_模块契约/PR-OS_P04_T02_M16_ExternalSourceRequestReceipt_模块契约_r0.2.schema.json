{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pr-os:p04:t02:external-source-request-receipt:0.2",
  "title": "P04 T09 ExternalSourceRequestReceipt r0.2",
  "$comment": "Non-model scholarly metadata API receipt. A valid receipt records evidence; it does not itself authorize a call.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "binding_mode", "receipt_stage", "recorded_at",
    "contract_owner_task_id", "phase_id", "task_id", "module_id", "run_id",
    "attempt_id", "external_call_id", "request_attempt_id", "retry_of_request_attempt_id",
    "role_family", "evidence_class", "central_5_8_compatibility_status", "profile_identity", "provider_identity",
    "request_identity", "route_identity", "artifact_bindings", "budget_and_retry",
    "authorization", "terms_snapshot", "request_disposition", "call_status",
    "external_call_performed", "response", "parser", "retry_disposition", "accounting",
    "data_and_rights", "side_effect_summary", "error_code", "source_evidence_refs",
    "qualification_eligibility", "reason_codes", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "p04.t02.external-source-request-receipt.0.2"},
    "record_type": {"const": "external_source_request_receipt"},
    "binding_mode": {"const": "PROSPECTIVE_STRICT"},
    "receipt_stage": {"enum": ["PRE_SEND", "TERMINAL"]},
    "recorded_at": {"type": "string", "format": "date-time"},
    "contract_owner_task_id": {"const": "T02"},
    "phase_id": {"const": "P04"},
    "task_id": {"const": "T09"},
    "module_id": {"const": "M16"},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "external_call_id": {"type": "string", "pattern": "^extcall_[a-f0-9]{24}$"},
    "request_attempt_id": {"type": "string", "pattern": "^extattempt_[a-f0-9]{24}$"},
    "retry_of_request_attempt_id": {"$ref": "#/$defs/nullableAttemptId"},
    "role_family": {"const": "NON_MODEL_SCHOLARLY_METADATA_RETRIEVAL"},
    "evidence_class": {"const": "P04_T09_A1_SOURCE_CANARY"},
    "central_5_8_compatibility_status": {"const": "APPROVED_BY_CENTRAL_SUCCESSOR"},
    "profile_identity": {"$ref": "#/$defs/profileIdentity"},
    "provider_identity": {"$ref": "#/$defs/providerIdentity"},
    "request_identity": {"$ref": "#/$defs/requestIdentity"},
    "route_identity": {"$ref": "#/$defs/routeIdentity"},
    "artifact_bindings": {"$ref": "#/$defs/artifactBindings"},
    "budget_and_retry": {"$ref": "#/$defs/budgetAndRetry"},
    "authorization": {"$ref": "#/$defs/authorization"},
    "terms_snapshot": {"$ref": "#/$defs/termsSnapshot"},
    "request_disposition": {"enum": ["BLOCKED_BEFORE_SEND", "AUTHORIZED_TO_SEND", "SENT"]},
    "call_status": {"enum": ["BLOCKED_BEFORE_SEND", "NOT_STARTED", "SUCCESS", "ERROR", "TIMEOUT", "CANCELLED"]},
    "external_call_performed": {"type": "boolean"},
    "response": {"$ref": "#/$defs/response"},
    "parser": {"$ref": "#/$defs/parser"},
    "retry_disposition": {"enum": ["NOT_APPLICABLE", "RETRY_ALLOWED_TRANSIENT", "RETRY_DENIED"]},
    "accounting": {"$ref": "#/$defs/accounting"},
    "data_and_rights": {"$ref": "#/$defs/dataAndRights"},
    "side_effect_summary": {"$ref": "#/$defs/sideEffects"},
    "error_code": {"$ref": "#/$defs/nullableNonEmptyString"},
    "source_evidence_refs": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/sourceEvidenceRef"}
    },
    "qualification_eligibility": {
      "enum": ["ELIGIBLE_FOR_T09_SOURCE_REPLAY", "NOT_ELIGIBLE_FOR_T09_SOURCE_REPLAY"]
    },
    "reason_codes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"receipt_stage": {"const": "PRE_SEND"}}, "required": ["receipt_stage"]},
      "then": {
        "properties": {
          "request_disposition": {"enum": ["BLOCKED_BEFORE_SEND", "AUTHORIZED_TO_SEND"]},
          "external_call_performed": {"const": false},
          "qualification_eligibility": {"const": "NOT_ELIGIBLE_FOR_T09_SOURCE_REPLAY"},
          "response": {"$ref": "#/$defs/blockedResponse"},
          "parser": {"$ref": "#/$defs/notRunParser"},
          "accounting": {"$ref": "#/$defs/blockedAccounting"}
        }
      }
    },
    {
      "if": {"properties": {"receipt_stage": {"const": "TERMINAL"}}, "required": ["receipt_stage"]},
      "then": {"properties": {"request_disposition": {"const": "SENT"}}}
    },
    {
      "if": {"properties": {"request_disposition": {"const": "BLOCKED_BEFORE_SEND"}}, "required": ["request_disposition"]},
      "then": {
        "properties": {
          "external_call_performed": {"const": false},
          "call_status": {"const": "BLOCKED_BEFORE_SEND"},
          "qualification_eligibility": {"const": "NOT_ELIGIBLE_FOR_T09_SOURCE_REPLAY"},
          "response": {"$ref": "#/$defs/blockedResponse"},
          "parser": {"$ref": "#/$defs/notRunParser"},
          "accounting": {"$ref": "#/$defs/blockedAccounting"}
        }
      }
    },
    {
      "if": {"properties": {"request_disposition": {"const": "SENT"}}, "required": ["request_disposition"]},
      "then": {
        "properties": {
          "external_call_performed": {"const": true},
          "authorization": {"$ref": "#/$defs/sentAuthorization"},
          "terms_snapshot": {"$ref": "#/$defs/sentTermsSnapshot"}
        }
      }
    },
    {
      "if": {"properties": {"call_status": {"const": "SUCCESS"}}, "required": ["call_status"]},
      "then": {
        "properties": {
          "response": {"$ref": "#/$defs/successResponse"},
          "parser": {"$ref": "#/$defs/successParser"},
          "qualification_eligibility": {"const": "ELIGIBLE_FOR_T09_SOURCE_REPLAY"},
          "error_code": {"const": null}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "nullableSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "nullableNonEmptyString": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "nullableAttemptId": {
      "anyOf": [{"type": "string", "pattern": "^extattempt_[a-f0-9]{24}$"}, {"type": "null"}]
    },
    "profileIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "profile_version", "profile_hash", "identity_status"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "profile_version": {"type": "string", "minLength": 1},
        "profile_hash": {"$ref": "#/$defs/sha256"},
        "identity_status": {"enum": ["VERIFIED", "RECORDED_UNVERIFIED"]}
      }
    },
    "providerIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["connector_id", "provider_kind", "requested_model", "returned_model", "field_applicability", "returned_identity_status", "provider_request_id_hash"],
      "properties": {
        "connector_id": {"enum": ["ARXIV", "CROSSREF"]},
        "provider_kind": {"const": "NON_MODEL_SCHOLARLY_METADATA_API"},
        "requested_model": {"const": "N/A_NON_MODEL_API"},
        "returned_model": {"const": "N/A_NON_MODEL_API"},
        "field_applicability": {"const": "NOT_APPLICABLE_NON_MODEL_API"},
        "returned_identity_status": {"enum": ["NOT_APPLICABLE", "PROVIDER_NOT_EXPOSED"]},
        "provider_request_id_hash": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "requestIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "endpoint_family", "base_endpoint", "method", "query_hash", "cursor_hash", "request_headers_hash"],
      "properties": {
        "operation": {"enum": ["CONNECTIVITY", "DISCOVERY"]},
        "endpoint_family": {"enum": ["ARXIV_QUERY", "CROSSREF_WORKS"]},
        "base_endpoint": {"enum": ["https://export.arxiv.org/api/query", "https://api.crossref.org/works"]},
        "method": {"const": "GET"},
        "query_hash": {"$ref": "#/$defs/sha256"},
        "cursor_hash": {"$ref": "#/$defs/nullableSha256"},
        "request_headers_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "routeIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["route_id", "route_snapshot_id", "provider_region", "egress_identity", "egress_identity_kind", "egress_receipt_id", "identity_status"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "route_snapshot_id": {"type": "string", "minLength": 1},
        "provider_region": {"type": "string", "minLength": 1},
        "egress_identity": {"type": "string", "minLength": 1},
        "egress_identity_kind": {"enum": ["OPAQUE_LABEL", "SHA256"]},
        "egress_receipt_id": {"type": "string", "minLength": 1},
        "identity_status": {"enum": ["VERIFIED", "RECORDED_UNVERIFIED"]}
      }
    },
    "artifactBindings": {
      "type": "object", "additionalProperties": false,
      "required": ["source_snapshot_id", "source_commit", "source_tree_hash", "runner_hash", "prompt_hash", "output_contract_hash", "scorer_hash", "input_manifest_hash", "input_hash", "output_hash", "error_hash"],
      "properties": {
        "source_snapshot_id": {"type": "string", "minLength": 1},
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_tree_hash": {"$ref": "#/$defs/sha256"},
        "runner_hash": {"$ref": "#/$defs/sha256"},
        "prompt_hash": {"$ref": "#/$defs/sha256"},
        "output_contract_hash": {"$ref": "#/$defs/sha256"},
        "scorer_hash": {"$ref": "#/$defs/nullableSha256"},
        "input_manifest_hash": {"$ref": "#/$defs/sha256"},
        "input_hash": {"$ref": "#/$defs/sha256"},
        "output_hash": {"$ref": "#/$defs/nullableSha256"},
        "error_hash": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "budgetAndRetry": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_index", "retry_ceiling", "global_main_attempt_ceiling", "global_retry_ceiling", "max_response_bytes", "max_records", "cost_ceiling_cny"],
      "properties": {
        "attempt_index": {"type": "integer", "minimum": 0},
        "retry_ceiling": {"type": "integer", "minimum": 0, "maximum": 2},
        "global_main_attempt_ceiling": {"const": 6},
        "global_retry_ceiling": {"const": 2},
        "max_response_bytes": {"type": "integer", "minimum": 1},
        "max_records": {"type": "integer", "minimum": 1, "maximum": 20},
        "cost_ceiling_cny": {"const": 0}
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "authorization_id", "authorization_text_sha256"],
      "properties": {
        "status": {"enum": ["NOT_AUTHORIZED", "AUTHORIZED_EXACT_REQUEST"]},
        "authorization_id": {"$ref": "#/$defs/nullableNonEmptyString"},
        "authorization_text_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "sentAuthorization": {
      "allOf": [
        {"$ref": "#/$defs/authorization"},
        {"properties": {"status": {"const": "AUTHORIZED_EXACT_REQUEST"}, "authorization_id": {"type": "string", "minLength": 1}, "authorization_text_sha256": {"$ref": "#/$defs/sha256"}}}
      ]
    },
    "termsSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "source_urls", "checked_at", "content_sha256"],
      "properties": {
        "status": {"enum": ["NOT_CHECKED_BLOCKING", "CURRENT_OFFICIAL_CHECKED"]},
        "source_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "checked_at": {"type": ["string", "null"], "format": "date-time"},
        "content_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "sentTermsSnapshot": {
      "allOf": [
        {"$ref": "#/$defs/termsSnapshot"},
        {"properties": {"status": {"const": "CURRENT_OFFICIAL_CHECKED"}, "source_urls": {"type": "array", "minItems": 1}, "checked_at": {"type": "string", "format": "date-time"}, "content_sha256": {"$ref": "#/$defs/sha256"}}}
      ]
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_status", "content_type", "raw_response_sha256", "raw_response_bytes", "allowed_headers_sha256", "response_path", "redirect_chain", "source_schema_revision"],
      "properties": {
        "protocol_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "content_type": {"$ref": "#/$defs/nullableNonEmptyString"},
        "raw_response_sha256": {"$ref": "#/$defs/nullableSha256"},
        "raw_response_bytes": {"type": ["integer", "null"], "minimum": 0},
        "allowed_headers_sha256": {"$ref": "#/$defs/nullableSha256"},
        "response_path": {"$ref": "#/$defs/nullableNonEmptyString"},
        "redirect_chain": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "source_schema_revision": {"$ref": "#/$defs/nullableNonEmptyString"}
      }
    },
    "blockedResponse": {
      "allOf": [
        {"$ref": "#/$defs/response"},
        {"properties": {"protocol_status": {"const": null}, "content_type": {"const": null}, "raw_response_sha256": {"const": null}, "raw_response_bytes": {"const": null}, "allowed_headers_sha256": {"const": null}, "response_path": {"const": null}, "redirect_chain": {"maxItems": 0}, "source_schema_revision": {"const": null}}}
      ]
    },
    "successResponse": {
      "allOf": [
        {"$ref": "#/$defs/response"},
        {"properties": {"protocol_status": {"type": "integer", "minimum": 200, "maximum": 299}, "content_type": {"type": "string", "minLength": 1}, "raw_response_sha256": {"$ref": "#/$defs/sha256"}, "raw_response_bytes": {"type": "integer", "minimum": 1}, "allowed_headers_sha256": {"$ref": "#/$defs/sha256"}, "response_path": {"type": "string", "minLength": 1}, "source_schema_revision": {"type": "string", "minLength": 1}}}
      ]
    },
    "parser": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "records_count", "output_hash", "error_hash"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "SUCCESS", "ERROR"]},
        "records_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 20},
        "output_hash": {"$ref": "#/$defs/nullableSha256"},
        "error_hash": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "notRunParser": {
      "allOf": [{"$ref": "#/$defs/parser"}, {"properties": {"status": {"const": "NOT_RUN"}, "records_count": {"const": null}, "output_hash": {"const": null}, "error_hash": {"const": null}}}]
    },
    "successParser": {
      "allOf": [{"$ref": "#/$defs/parser"}, {"properties": {"status": {"const": "SUCCESS"}, "records_count": {"type": "integer", "minimum": 0, "maximum": 20}, "output_hash": {"$ref": "#/$defs/sha256"}, "error_hash": {"const": null}}}]
    },
    "accounting": {
      "type": "object", "additionalProperties": false,
      "required": ["request_started_at", "response_completed_at", "latency_ms", "input_tokens", "output_tokens", "reasoning_tokens", "total_tokens", "actual_cost", "estimated_cost", "currency", "usage_status", "pricing_status"],
      "properties": {
        "request_started_at": {"type": ["string", "null"], "format": "date-time"},
        "response_completed_at": {"type": ["string", "null"], "format": "date-time"},
        "latency_ms": {"type": ["number", "null"], "minimum": 0},
        "input_tokens": {"const": 0}, "output_tokens": {"const": 0},
        "reasoning_tokens": {"const": 0}, "total_tokens": {"const": 0},
        "actual_cost": {"const": 0}, "estimated_cost": {"const": 0},
        "currency": {"const": "CNY"},
        "usage_status": {"const": "NOT_APPLICABLE_NON_MODEL_API"},
        "pricing_status": {"const": "EXACT_ZERO"}
      }
    },
    "blockedAccounting": {
      "allOf": [{"$ref": "#/$defs/accounting"}, {"properties": {"request_started_at": {"const": null}, "response_completed_at": {"const": null}, "latency_ms": {"const": null}}}]
    },
    "dataAndRights": {
      "type": "object", "additionalProperties": false,
      "required": ["data_ownership", "license_status", "local_materialization", "fulltext_downloaded"],
      "properties": {
        "data_ownership": {"const": "PUBLIC_METADATA_SUBJECT_TO_CURRENT_TERMS"},
        "license_status": {"enum": ["CURRENT_TERMS_REVIEWED", "NOT_APPLICABLE_BLOCKED"]},
        "local_materialization": {"type": "boolean"},
        "fulltext_downloaded": {"const": false}
      }
    },
    "sideEffects": {
      "type": "object", "additionalProperties": false,
      "required": ["network_requests", "model_calls", "pdf_downloads", "production_writes", "formal_state_mutations"],
      "properties": {
        "network_requests": {"type": "integer", "minimum": 0, "maximum": 1},
        "model_calls": {"const": 0}, "pdf_downloads": {"const": 0},
        "production_writes": {"const": 0}, "formal_state_mutations": {"const": 0}
      }
    },
    "sourceEvidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "sha256", "evidence_status"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/nullableSha256"},
        "evidence_status": {"enum": ["EXACT_RECORDED", "EXACT_JOINED"]}
      }
    }
  }
}

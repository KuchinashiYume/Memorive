{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pr-os:p04:t01:state-transition-contract:r0.1",
  "title": "P04/T01 Orthogonal State Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "maturity",
    "run",
    "candidate"
  ],
  "properties": {
    "schema_version": {
      "const": "p04-t01-common-contract-r0.1-candidate001"
    },
    "maturity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_status",
        "implementation_status",
        "verification_status",
        "deployment_status"
      ],
      "properties": {
        "design_status": {
          "enum": [
            "proposed",
            "approved",
            "superseded"
          ]
        },
        "implementation_status": {
          "enum": [
            "not_started",
            "partial",
            "implemented"
          ]
        },
        "verification_status": {
          "enum": [
            "untested",
            "tested",
            "qualified"
          ]
        },
        "deployment_status": {
          "enum": [
            "disabled",
            "pilot",
            "active"
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_status",
        "verification_result",
        "acceptance_verdict"
      ],
      "properties": {
        "lifecycle_status": {
          "enum": [
            "completed",
            "aborted",
            "invalidated"
          ]
        },
        "verification_result": {
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "NOT_RUN"
          ]
        },
        "acceptance_verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_ASSESSED"
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_status",
        "access_status",
        "decision_status",
        "candidate_card_status",
        "promotion_status"
      ],
      "properties": {
        "identity_status": {
          "enum": [
            "HINT_UNVERIFIED",
            "RESOLVING",
            "VERIFIED",
            "CONFLICT",
            "UNRESOLVED"
          ]
        },
        "access_status": {
          "enum": [
            "METADATA_ONLY",
            "OA_LOCATION_CLAIMED",
            "RIGHTS_VERIFIED",
            "MATERIALIZED",
            "UNAVAILABLE",
            "RESTRICTED"
          ]
        },
        "decision_status": {
          "enum": [
            "PENDING",
            "SNOOZED",
            "APPROVED_FOR_CARD_STAGING",
            "REJECTED"
          ]
        },
        "candidate_card_status": {
          "enum": [
            "NOT_REQUESTED",
            "BUILDING",
            "REVIEW_READY",
            "NEEDS_REPAIR",
            "FAILED"
          ]
        },
        "promotion_status": {
          "enum": [
            "NOT_ELIGIBLE",
            "READY",
            "PROMOTION_APPROVED",
            "PROMOTED",
            "FAILED"
          ]
        }
      }
    }
  }
}

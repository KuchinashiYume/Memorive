{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pr-os.p04.t08.promotion-transaction-journal-entry.v1",
  "title": "PromotionTransactionJournalEntry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "promotion_id", "intent_hash", "state", "event", "recorded_at", "evidence", "content_hash"],
  "properties": {
    "schema_version": {"const": "pr-os.p04.t08.promotion-transaction-journal-entry.v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "promotion_id": {"type": "string", "minLength": 1},
    "intent_hash": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "state": {"enum": ["PRECHECKED", "PREPARED", "COMMITTING", "COMMITTED", "ROLLED_BACK", "COMPENSATION_REQUIRED"]},
    "event": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "evidence": {"type": "object"},
    "content_hash": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
  }
}

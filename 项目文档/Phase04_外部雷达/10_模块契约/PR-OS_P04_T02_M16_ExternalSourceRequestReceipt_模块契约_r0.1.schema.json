{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pr-os:p04:t02:external-source-request-receipt:0.1",
  "title": "P04 T02 ExternalSourceRequestReceipt Candidate",
  "$comment": "This is a non-model candidate contract. It does not claim approval as a central r1.0 model-call receipt replacement.",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "nullableString": {"type": ["string", "null"], "minLength": 1}
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "phase_id",
    "task_id",
    "module_id",
    "run_id",
    "attempt_id",
    "request_id",
    "retry_of_request_id",
    "connector_id",
    "provider_kind",
    "endpoint_family",
    "query_hash",
    "cursor_hash",
    "model_identity",
    "central_5_8_compatibility_status",
    "authorization",
    "terms_snapshot",
    "route_identity",
    "timing",
    "response",
    "retry",
    "accounting",
    "data_and_rights",
    "request_disposition",
    "call_status",
    "external_call_performed",
    "error_code",
    "source_evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "p04.t02.external-source-request-receipt.0.1"},
    "record_type": {"const": "external_source_request_receipt"},
    "phase_id": {"const": "P04"},
    "task_id": {"const": "T02"},
    "module_id": {"const": "M16"},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "pattern": "^extreq_[a-f0-9]{24}$"},
    "retry_of_request_id": {"type": ["string", "null"], "pattern": "^extreq_[a-f0-9]{24}$"},
    "connector_id": {"enum": ["ARXIV", "CROSSREF"]},
    "provider_kind": {"const": "NON_MODEL_SCHOLARLY_METADATA_API"},
    "endpoint_family": {"enum": ["ARXIV_QUERY", "CROSSREF_WORKS"]},
    "query_hash": {"$ref": "#/$defs/sha256"},
    "cursor_hash": {"$ref": "#/$defs/nullableSha256"},
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_model", "returned_model", "field_applicability", "reason_code"],
      "properties": {
        "requested_model": {"type": "null"},
        "returned_model": {"type": "null"},
        "field_applicability": {"const": "NOT_APPLICABLE_NON_MODEL_API"},
        "reason_code": {"const": "SCHOLARLY_METADATA_API_IS_NOT_A_MODEL_PROVIDER"}
      }
    },
    "central_5_8_compatibility_status": {"enum": ["UNRESOLVED_BLOCKING", "APPROVED_BY_CENTRAL_SUCCESSOR"]},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authorization_id"],
      "properties": {
        "status": {"enum": ["NOT_AUTHORIZED", "AUTHORIZED_EXACT_REQUEST"]},
        "authorization_id": {"$ref": "#/$defs/nullableString"}
      }
    },
    "terms_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_url", "checked_at", "content_sha256"],
      "properties": {
        "status": {"enum": ["NOT_CHECKED_OFFLINE", "CURRENT_OFFICIAL_CHECKED"]},
        "source_url": {"$ref": "#/$defs/nullableString"},
        "checked_at": {"type": ["string", "null"], "format": "date-time"},
        "content_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "route_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "route_snapshot_id", "provider_region", "egress_identity", "egress_identity_kind", "egress_receipt_id", "status"],
      "properties": {
        "route_id": {"$ref": "#/$defs/nullableString"},
        "route_snapshot_id": {"$ref": "#/$defs/nullableString"},
        "provider_region": {"$ref": "#/$defs/nullableString"},
        "egress_identity": {"$ref": "#/$defs/nullableString"},
        "egress_identity_kind": {"enum": ["NOT_FROZEN", "OPAQUE_LABEL", "SHA256"]},
        "egress_receipt_id": {"$ref": "#/$defs/nullableString"},
        "status": {"enum": ["NOT_FROZEN_BLOCKING", "VERIFIED", "RECORDED_UNVERIFIED"]}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight_recorded_at", "request_started_at", "response_finished_at", "latency_ms"],
      "properties": {
        "preflight_recorded_at": {"type": "string", "format": "date-time"},
        "request_started_at": {"type": ["string", "null"], "format": "date-time"},
        "response_finished_at": {"type": ["string", "null"], "format": "date-time"},
        "latency_ms": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_status", "source_schema_revision", "raw_response_sha256", "public_safe_summary_sha256"],
      "properties": {
        "protocol_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
        "source_schema_revision": {"$ref": "#/$defs/nullableString"},
        "raw_response_sha256": {"$ref": "#/$defs/nullableSha256"},
        "public_safe_summary_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_index", "retry_ceiling", "backoff_seconds"],
      "properties": {
        "attempt_index": {"type": "integer", "minimum": 0},
        "retry_ceiling": {"type": "integer", "minimum": 0},
        "backoff_seconds": {"type": "number", "minimum": 0}
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cost_amount", "currency", "cost_status"],
      "properties": {
        "cost_amount": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": ["string", "null"], "minLength": 1},
        "cost_status": {"enum": ["NOT_APPLICABLE_BLOCKED_BEFORE_SEND", "EXACT_ZERO", "EXACT_RECORDED", "UNKNOWN_NOT_ELIGIBLE"]}
      }
    },
    "data_and_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_ownership", "license_status", "local_materialization", "fulltext_downloaded"],
      "properties": {
        "data_ownership": {"enum": ["SYNTHETIC_SELF_OWNED", "PUBLIC_METADATA_SUBJECT_TO_CURRENT_TERMS"]},
        "license_status": {"enum": ["NOT_APPLICABLE_BLOCKED", "CURRENT_TERMS_REVIEWED"]},
        "local_materialization": {"type": "boolean"},
        "fulltext_downloaded": {"const": false}
      }
    },
    "request_disposition": {"enum": ["BLOCKED_BEFORE_SEND", "SENT"]},
    "call_status": {"enum": ["BLOCKED_BEFORE_SEND", "SUCCESS", "ERROR", "TIMEOUT", "CANCELLED"]},
    "external_call_performed": {"type": "boolean"},
    "error_code": {"$ref": "#/$defs/nullableString"},
    "source_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"request_disposition": {"const": "BLOCKED_BEFORE_SEND"}}, "required": ["request_disposition"]},
      "then": {
        "properties": {
          "external_call_performed": {"const": false},
          "call_status": {"const": "BLOCKED_BEFORE_SEND"},
          "response": {
            "properties": {
              "protocol_status": {"type": "null"},
              "raw_response_sha256": {"type": "null"},
              "public_safe_summary_sha256": {"type": "null"}
            }
          },
          "timing": {
            "properties": {
              "request_started_at": {"type": "null"},
              "response_finished_at": {"type": "null"},
              "latency_ms": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"request_disposition": {"const": "SENT"}}, "required": ["request_disposition"]},
      "then": {
        "properties": {
          "central_5_8_compatibility_status": {"const": "APPROVED_BY_CENTRAL_SUCCESSOR"},
          "authorization": {
            "properties": {
              "status": {"const": "AUTHORIZED_EXACT_REQUEST"},
              "authorization_id": {"type": "string"}
            }
          },
          "terms_snapshot": {
            "properties": {
              "status": {"const": "CURRENT_OFFICIAL_CHECKED"},
              "source_url": {"type": "string"},
              "checked_at": {"type": "string"},
              "content_sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "route_identity": {
            "properties": {
              "route_id": {"type": "string"},
              "route_snapshot_id": {"type": "string"},
              "provider_region": {"type": "string"},
              "egress_identity": {"type": "string"},
              "egress_identity_kind": {"enum": ["OPAQUE_LABEL", "SHA256"]},
              "egress_receipt_id": {"type": "string"},
              "status": {"enum": ["VERIFIED", "RECORDED_UNVERIFIED"]}
            }
          },
          "external_call_performed": {"const": true},
          "timing": {
            "properties": {
              "request_started_at": {"type": "string"},
              "response_finished_at": {"type": "string"},
              "latency_ms": {"type": "integer"}
            }
          },
          "response": {
            "properties": {
              "protocol_status": {"type": "integer"},
              "source_schema_revision": {"type": "string"},
              "raw_response_sha256": {"$ref": "#/$defs/sha256"},
              "public_safe_summary_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    }
  ]
}

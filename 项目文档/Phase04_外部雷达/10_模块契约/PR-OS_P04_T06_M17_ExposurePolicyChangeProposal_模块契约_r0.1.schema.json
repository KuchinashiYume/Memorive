{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pr-os:p04:t06:exposure-policy-change-proposal:0.1",
  "title": "P04 T06 inert ExposurePolicyChangeProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "object_type", "proposal_id", "base_policy_revision",
    "target_revision", "status", "direction_ids", "digest_hash", "evidence_refs",
    "proposed_change", "applied", "profile_writes", "policy_writes",
    "proposal_hash", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "p04.t06.exposure-policy-change-proposal.0.1"},
    "object_type": {"const": "ExposurePolicyChangeProposal"},
    "proposal_id": {"type": "string", "pattern": "^PROPOSAL:[a-f0-9]{24}$"},
    "base_policy_revision": {"type": "string", "minLength": 1},
    "target_revision": {"const": "UNASSIGNED_UNTIL_HUMAN_CONFIRMATION"},
    "status": {"const": "PENDING_HUMAN_CONFIRMATION"},
    "direction_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "digest_hash": {"$ref": "#/$defs/sha256"},
    "evidence_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "proposed_change": {"const": "REVIEW_EXPOSURE_BUDGET_ONLY"},
    "applied": {"const": false},
    "profile_writes": {"const": 0},
    "policy_writes": {"const": 0},
    "proposal_hash": {"$ref": "#/$defs/sha256"},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}

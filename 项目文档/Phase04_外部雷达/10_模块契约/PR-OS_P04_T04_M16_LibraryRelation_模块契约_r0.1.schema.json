{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pr-os:p04:t04:library-relation:0.1",
  "title": "LibraryRelation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "object_type", "relation_id", "candidate_id", "local_paper_id",
    "local_title", "relation_type", "evidence_method", "evidence_refs", "similar_dimensions",
    "different_dimensions", "evidence_level", "evidence_scope", "algorithm_revision",
    "profile_refs", "measurements", "reason_codes", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "p04.t04.library-relation.0.1"},
    "object_type": {"const": "LibraryRelation"},
    "relation_id": {"type": "string", "pattern": "^library_relation_[a-f0-9]{24}$"},
    "candidate_id": {"type": "string", "pattern": "^CANDIDATE:[A-Z0-9_-]+$"},
    "local_paper_id": {"type": "string", "pattern": "^PAPER:[A-Z0-9_-]+$"},
    "local_title": {"type": "string", "minLength": 1},
    "relation_type": {
      "enum": [
        "EXACT_SAME_WORK", "ALTERNATE_VERSION", "POSSIBLE_DUPLICATE",
        "DIRECT_CITATION_RELATION", "TOPIC_SIMILAR", "METHOD_SIMILAR", "OBJECT_SIMILAR",
        "BRIDGE_BETWEEN_DIRECTIONS", "NEW_TO_LIBRARY"
      ]
    },
    "evidence_method": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "similar_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "different_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_level": {"enum": ["EXACT_IDENTITY", "EXPLICIT_VERSION", "EXPLICIT_EDGE", "FIELD_VECTOR", "ABSTRACT_LEVEL_ESTIMATE", "SCOPE_COVERAGE"]},
    "evidence_scope": {"enum": ["IDENTITY_ONLY", "METADATA_ONLY", "ABSTRACT_LEVEL", "FROZEN_CITATION_GRAPH", "COMPLETE_LIBRARY_SCOPE"]},
    "algorithm_revision": {"const": "p04.t04.relation-resolver.0.1"},
    "profile_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "measurements": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dimension", "profile_id", "metric", "value", "threshold", "match_rule"],
        "properties": {
          "dimension": {"enum": ["topic", "method", "object"]},
          "profile_id": {"type": "string"},
          "metric": {"enum": ["COSINE_SIMILARITY", "EUCLIDEAN_DISTANCE"]},
          "value": {"type": "number"},
          "threshold": {"type": "number"},
          "match_rule": {"enum": ["GTE", "LTE"]}
        }
      }
    },
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "content_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}

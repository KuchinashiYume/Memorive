{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pr-os:p04:t05:recall-channel-candidate:0.1",
  "title": "P04 T05 RecallChannelCandidate and ChannelRankingEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "object_type", "candidate_id", "work_cluster_id", "fact_hash",
    "primary_channel", "eligible_channels", "eligibility", "ranking_evidence", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "p04.t05.recall-channel-candidate.0.1"},
    "object_type": {"const": "RecallChannelCandidate"},
    "candidate_id": {"type": "string", "pattern": "^CANDIDATE:[A-Z0-9_-]+$"},
    "work_cluster_id": {"type": "string", "minLength": 1},
    "fact_hash": {"$ref": "#/$defs/sha256"},
    "primary_channel": {"anyOf": [{"$ref": "#/$defs/channel"}, {"type": "null"}]},
    "eligible_channels": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/channel"}},
    "eligibility": {
      "type": "object", "additionalProperties": false,
      "required": ["eligible", "reason_codes"],
      "properties": {
        "eligible": {"type": "boolean"},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "ranking_evidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["channel", "components", "comparison_key", "tie_break_identity", "evidence_refs", "global_scalar_score"],
      "properties": {
        "channel": {"$ref": "#/$defs/channel"},
        "components": {
          "type": "object", "additionalProperties": false,
          "required": ["direction_match", "evidence_completeness", "library_novelty", "timeliness", "access_posture"],
          "properties": {
            "direction_match": {"type": "integer", "minimum": 0, "maximum": 4},
            "evidence_completeness": {"type": "integer", "minimum": 0, "maximum": 3},
            "library_novelty": {"type": "integer", "minimum": 0, "maximum": 2},
            "timeliness": {"type": "integer", "minimum": 0, "maximum": 3},
            "access_posture": {"type": "integer", "minimum": 0, "maximum": 2}
          }
        },
        "comparison_key": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {"type": "integer"}
        },
        "tie_break_identity": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "global_scalar_score": {"type": "null"}
      }
    },
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "channel": {"enum": ["CORE", "ADJACENT", "BRIDGE", "HORIZON", "COVERAGE_REPAIR"]}
  }
}

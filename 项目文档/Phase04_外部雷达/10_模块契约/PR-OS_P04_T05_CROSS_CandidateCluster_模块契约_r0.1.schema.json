{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pr-os:p04:t05:candidate-cluster:0.1",
  "title": "P04 T05 CandidateCluster",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "object_type", "cluster_id", "work_cluster_id", "member_candidate_ids",
    "representative_candidate_id", "representative_reason_codes", "primary_channel",
    "suppressed_members", "identity_facts_created", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "p04.t05.candidate-cluster.0.1"},
    "object_type": {"const": "CandidateCluster"},
    "cluster_id": {"type": "string", "pattern": "^T05_CLUSTER:[a-f0-9]{24}$"},
    "work_cluster_id": {"type": "string", "minLength": 1},
    "member_candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "representative_candidate_id": {"type": "string", "pattern": "^CANDIDATE:[A-Z0-9_-]+$"},
    "representative_reason_codes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["IDENTITY_VERIFIED", "EVIDENCE_COMPLETENESS_ORDER", "MANIFESTATION_FITNESS_ORDER", "ACCESS_POSTURE_ORDER", "CANONICAL_TIE_BREAK"]}
    },
    "primary_channel": {"anyOf": [{"$ref": "#/$defs/channel"}, {"type": "null"}]},
    "suppressed_members": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "reason_codes"],
        "properties": {
          "candidate_id": {"type": "string"},
          "reason_codes": {"type": "array", "const": ["NON_REPRESENTATIVE_MANIFESTATION"]}
        }
      }
    },
    "identity_facts_created": {"const": 0},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "channel": {"enum": ["CORE", "ADJACENT", "BRIDGE", "HORIZON", "COVERAGE_REPAIR"]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pr-os:p04:t09:input-manifest:0.1",
  "title": "P04 T09 InputManifest r0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "runner_version", "run_kind", "run_id", "frozen_as_of",
    "classification", "source_commit", "source_git_tree_oid", "formal_code_inventory",
    "members"
  ],
  "properties": {
    "schema_version": {"const": "p04.t09.input-manifest.0.1"},
    "runner_version": {"const": "p04.t09.cross-acceptance-runner.0.2"},
    "run_kind": {"enum": ["A0_SYNTHETIC", "SHADOW_B_FROZEN_A1"]},
    "run_id": {"type": "string", "minLength": 1},
    "frozen_as_of": {"type": "string", "format": "date-time"},
    "classification": {"enum": [
      "PUBLIC_SAFE_A0_WITH_LOCAL_ONLY_P03_SNAPSHOT",
      "FROZEN_A1_METADATA_REPLAY_WITH_LOCAL_ONLY_P03_SNAPSHOT"
    ]},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_git_tree_oid": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "formal_code_inventory": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "git_blob_oid", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "git_blob_oid": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "members": {
      "type": "array", "minItems": 14, "maxItems": 18,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "slot", "provider", "path", "sha256", "bytes"],
        "properties": {
          "role": {"enum": [
            "profile_policy", "local_snapshot", "local_snapshot_lineage",
            "source_response", "source_receipt", "connectivity_response",
            "connectivity_receipt", "synthetic_gate_seed", "authority_matrix",
            "freeze_verification"
          ]},
          "slot": {"type": ["string", "null"]},
          "provider": {"enum": ["ARXIV", "CROSSREF", null]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"run_kind": {"const": "A0_SYNTHETIC"}}, "required": ["run_kind"]},
      "then": {
        "properties": {
          "classification": {"const": "PUBLIC_SAFE_A0_WITH_LOCAL_ONLY_P03_SNAPSHOT"},
          "members": {"minItems": 14, "maxItems": 14}
        }
      }
    },
    {
      "if": {"properties": {"run_kind": {"const": "SHADOW_B_FROZEN_A1"}}, "required": ["run_kind"]},
      "then": {
        "properties": {
          "classification": {"const": "FROZEN_A1_METADATA_REPLAY_WITH_LOCAL_ONLY_P03_SNAPSHOT"},
          "members": {"minItems": 18, "maxItems": 18}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}

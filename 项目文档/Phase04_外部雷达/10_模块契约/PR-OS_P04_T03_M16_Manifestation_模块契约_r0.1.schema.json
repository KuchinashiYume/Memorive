{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pr-os:p04:t03:manifestation:0.1",
  "title": "P04 T03 Manifestation",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "observationRef": {"type": "string", "pattern": "^source_observation_[a-f0-9]{24}$"},
    "identifier": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "value", "base_value", "version"],
      "properties": {
        "kind": {"enum": ["DOI", "ARXIV", "PMID"]},
        "value": {"type": "string", "minLength": 1},
        "base_value": {"type": ["string", "null"]},
        "version": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_ref", "title", "authors", "published_year", "record_type"],
      "properties": {
        "observation_ref": {"$ref": "#/$defs/observationRef"},
        "title": {"type": "string", "minLength": 1},
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "published_year": {"type": ["integer", "null"], "minimum": 1000, "maximum": 9999},
        "record_type": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "object_type", "object_id", "manifestation_id", "revision",
    "content_hash", "producer", "single_writer", "consumers", "identity_ref",
    "identity_status", "manifestation_role", "identifier_set", "source_observation_refs",
    "bibliographic_claims", "work_cluster_id", "version_edge_refs", "source_observations_preserved"
  ],
  "properties": {
    "schema_version": {"const": "p04.t03.manifestation.0.1"},
    "object_type": {"const": "Manifestation"},
    "object_id": {"type": "string", "pattern": "^manifestation_(identity|claim)_[a-f0-9]{24}$"},
    "manifestation_id": {"type": "string", "pattern": "^manifestation_(identity|claim)_[a-f0-9]{24}$"},
    "revision": {"const": 1},
    "content_hash": {"$ref": "#/$defs/sha256"},
    "producer": {"const": "P04/T03/M16"},
    "single_writer": {"const": "M16.IDENTITY_RESOLVER"},
    "consumers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["M16.CANDIDATE_REGISTRY", "P04/T04/CROSS"]}},
    "identity_ref": {"type": "string", "pattern": "^bibliographic_identity_[a-f0-9]{24}$"},
    "identity_status": {"enum": ["VERIFIED", "CONFLICT", "UNRESOLVED"]},
    "manifestation_role": {"enum": ["PREPRINT", "CONFERENCE", "AUTHOR_ACCEPTED_MANUSCRIPT", "VERSION_OF_RECORD", "UNKNOWN"]},
    "identifier_set": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "source_observation_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/observationRef"}},
    "bibliographic_claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "work_cluster_id": {"type": "string", "pattern": "^work_cluster_[a-f0-9]{24}$"},
    "version_edge_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^version_edge_[a-f0-9]{24}$"}},
    "source_observations_preserved": {"const": true}
  }
}

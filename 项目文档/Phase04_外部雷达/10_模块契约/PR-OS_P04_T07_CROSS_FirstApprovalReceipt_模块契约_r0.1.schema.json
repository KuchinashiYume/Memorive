{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pros:p04:t07:first-approval-receipt:r0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "fixture_id", "fixture_authority", "candidate_id", "work_cluster_id",
    "manifestation_id", "candidate_revision", "source_revision", "decision_status", "revoked",
    "issued_at", "expires_at", "approved_source_sha256", "scope"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "fixture_id": {"type": "string"},
    "fixture_authority": {"const": "PR_OS_SELF_AUTHORED_PUBLIC_SAFE_SYNTHETIC"},
    "candidate_id": {"type": "string"},
    "work_cluster_id": {"type": "string"},
    "manifestation_id": {"type": "string"},
    "candidate_revision": {"type": "string"},
    "source_revision": {"type": "string"},
    "decision_status": {"const": "APPROVED_FOR_CARD_STAGING"},
    "revoked": {"const": false},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "approved_source_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "scope": {"const": "PURE_OFFLINE_A0_SYNTHETIC_CARD_STAGING_ONLY"}
  }
}

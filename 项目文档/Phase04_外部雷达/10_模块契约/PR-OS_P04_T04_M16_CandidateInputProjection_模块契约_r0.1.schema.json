{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pr-os:p04:t04:candidate-input:0.1",
  "title": "T03-compatible Candidate Input Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "object_type", "candidate_id", "identity_status", "access_status",
    "decision_status", "candidate_card_status", "promotion_status", "t04_input_eligible",
    "work_cluster_id", "manifestation_ids", "identifiers", "title", "publication_date",
    "fields", "query_vectors", "vector_profile_refs", "citation_claims", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "p04.t04.candidate-input.0.1"},
    "object_type": {"const": "CandidateRecord"},
    "candidate_id": {"type": "string", "pattern": "^CANDIDATE:[A-Z0-9_-]+$"},
    "identity_status": {"enum": ["VERIFIED", "CONFLICT", "UNRESOLVED"]},
    "access_status": {"type": "string"},
    "decision_status": {"type": "string"},
    "candidate_card_status": {"type": "string"},
    "promotion_status": {"type": "string"},
    "t04_input_eligible": {"type": "boolean"},
    "work_cluster_id": {"type": "string", "minLength": 1},
    "manifestation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "identifiers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "title": {"type": "string", "minLength": 1},
    "publication_date": {"type": ["string", "null"], "format": "date"},
    "fields": {
      "type": "object", "additionalProperties": false,
      "required": ["topic", "method", "object", "abstract"],
      "properties": {
        "topic": {"type": "string"}, "method": {"type": "string"},
        "object": {"type": "string"}, "abstract": {"type": "string"}
      }
    },
    "query_vectors": {
      "type": "object", "additionalProperties": false,
      "required": ["topic", "method", "object"],
      "properties": {
        "topic": {"$ref": "#/$defs/vector"}, "method": {"$ref": "#/$defs/vector"},
        "object": {"$ref": "#/$defs/vector"}
      }
    },
    "vector_profile_refs": {
      "type": "object", "additionalProperties": false,
      "required": ["topic", "method", "object"],
      "properties": {
        "topic": {"type": "string"}, "method": {"type": "string"}, "object": {"type": "string"}
      }
    },
    "citation_claims": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "content_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  },
  "$defs": {
    "vector": {"type": "array", "minItems": 1, "items": {"type": "number"}}
  }
}

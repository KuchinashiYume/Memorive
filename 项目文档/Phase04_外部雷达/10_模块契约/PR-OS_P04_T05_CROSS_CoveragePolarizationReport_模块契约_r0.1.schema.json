{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pr-os:p04:t05:coverage-polarization-report:0.1",
  "title": "P04 T05 CoverageConcentrationReport and PolarizationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "object_type", "report_id", "slate_hash", "as_of", "windows",
    "warnings", "proposal_boundary", "profile_mutations", "policy_mutations", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "p04.t05.coverage-polarization-report.0.1"},
    "object_type": {"const": "CoveragePolarizationReport"},
    "report_id": {"type": "string", "pattern": "^T05_REPORT:[a-f0-9]{24}$"},
    "slate_hash": {"$ref": "#/$defs/sha256"},
    "as_of": {"type": "string", "format": "date-time"},
    "windows": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/window"}
    },
    "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "proposal_boundary": {"const": "T06_ONLY_NO_MUTATION"},
    "profile_mutations": {"const": 0},
    "policy_mutations": {"const": 0},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "channel": {"enum": ["CORE", "ADJACENT", "BRIDGE", "HORIZON", "COVERAGE_REPAIR"]},
    "window": {
      "type": "object", "additionalProperties": false,
      "required": [
        "days", "cutoff", "status", "denominator", "counted_exposures", "direction_rows",
        "channel_counts", "channel_gaps", "warnings"
      ],
      "properties": {
        "days": {"enum": [30, 90]},
        "cutoff": {"type": "string", "format": "date-time"},
        "status": {"enum": ["COMPLETE", "UNKNOWN"]},
        "denominator": {"type": ["integer", "null"], "minimum": 0},
        "counted_exposures": {"type": ["integer", "null"], "minimum": 0},
        "direction_rows": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["direction_id", "planned_current_slate_count", "actual_exposure_count", "share", "concentration_cap_breach"],
            "properties": {
              "direction_id": {"type": "string"},
              "planned_current_slate_count": {"type": "integer", "minimum": 0},
              "actual_exposure_count": {"type": ["integer", "null"], "minimum": 0},
              "share": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "concentration_cap_breach": {"type": ["boolean", "null"]}
            }
          }
        },
        "channel_counts": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/channel"},
          "additionalProperties": {"type": ["integer", "null"], "minimum": 0}
        },
        "channel_gaps": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/channel"},
          "additionalProperties": {"type": ["integer", "null"], "minimum": 0}
        },
        "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
